# Test fixtures (generated, not committed)
# Anchored to the paths that are actually generated. Unanchored, `Fixtures/` matched *any* directory
# named that at any depth — and, because git is set to ignore case here, `Tools/vm/fixtures/` too. Those
# are three small hand-written files the VM harness needs, and a fresh clone could not have run the
# editor scenarios without them.
/Fixtures/
/Tools/fixtures/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Code coverage
*.profraw
*.profdata
coverage/

# Sparkle (added in I20)
Sparkle/
PluginSDK/.build/

# Startup films (Tools/vm/startup.py) — a diagnostic that changes on every run.
# The probe report and one settled frame are committed as the evidence; the strip is not.
docs/generated/startup/frame-*.png
docs/generated/startup/log.txt
