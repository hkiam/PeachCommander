<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>AIColumn</string>
	<key>CFBundleExecutable</key>
	<string>AIColumn</string>
	<key>CFBundlePackageType</key>
	<string>BNDL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<!-- Ships switched off with the rest of the AI family (F-448), and stays optional by decision.
	     NOT because it is expensive or far-reaching: it starts no model, links nothing, and answers
	     each row from a JSON file the on-device actions wrote. The older reason recorded here — "a
	     column that calls the model once per visible row" — described something this plugin has
	     never done. It shows nothing at all until somebody both switches it on and adds one of its
	     columns to a column set, which is why being off costs a reader nothing they can see. -->
	<key>PCPluginEnabledByDefault</key><false/>
	<key>PCPluginType</key>
	<string>pdx</string>
	<key>PCPluginAPIVersion</key>
	<integer>1</integer>
	<key>PCPluginName</key>
	<string>AI Column</string>
	<key>PCPluginExtensions</key>
	<array>
		<string>*</string>
	</array>
	<key>PCPluginMinHostVersion</key>
	<integer>1</integer>
</dict>
</plist>
