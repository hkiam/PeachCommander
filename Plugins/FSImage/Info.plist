<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key><string>FSImage</string>
	<key>CFBundleExecutable</key><string>FSImage</string>
	<key>CFBundlePackageType</key><string>BNDL</string>
	<key>CFBundleShortVersionString</key><string>1.0</string>
	<key>CFBundleVersion</key><string>1</string>
	<key>PCPluginType</key><string>pcx</string>
	<key>PCPluginAPIVersion</key><integer>1</integer>
	<key>PCPluginName</key><string>Linux Filesystem Images</string>
	<key>PCPluginMinHostVersion</key><integer>1</integer>
	<!-- Only names that mean this and nothing else. `img`, `bin` and `rootfs` used to
	     be here because the host picked a packer by extension alone and firmware is
	     not named tidily — but claiming three of the most generic extensions on the
	     system to catch them was a poor trade. The host now asks
	     `CanYouHandleThisFile` when no extension matches, so those files are
	     recognised by their magic instead, and a `.bin` that is not an image is never
	     claimed at all. -->
	<key>PCPluginExtensions</key><string>squashfs;sqsh;sfs;jffs2;jffs;cramfs;ext2;ext3;ext4;btrfs;initramfs;initrd;ubifs;ubi;img;disk;fat;vfat;exfat;ntfs</string>
	<!-- Off until the user asks for it (F-345). Content detection means reading a
	     header off every file whose extension matched nothing, and only somebody who
	     wants a firmware browser should pay for that. -->
	<key>PCPluginEnabledByDefault</key><false/>
	<!-- One command, in Commands. It writes a layout report rather than navigating,
	     because a contributed command can only open real paths (`openPath`) and has no
	     way to mount an image — pressing Enter on the file is what does that. The
	     title is looked up in this plugin's own Localizable.strings. -->
	<key>PCContributions</key>
	<dict>
		<key>commands</key>
		<array>
			<dict>
				<key>id</key><string>plugin.fsimage.layout</string>
				<key>title</key><string>Scan Image Layout…</string>
				<key>category</key><string>Tools</string>
			</dict>
		</array>
		<key>menus</key>
		<array>
			<dict>
				<key>command</key><string>plugin.fsimage.layout</string>
				<key>menu</key><string>Commands</string>
				<key>group</key><string>2_tools</string>
				<key>order</key><integer>120</integer>
			</dict>
		</array>
		<key>contextMenus</key>
		<array>
			<dict>
				<key>command</key><string>plugin.fsimage.layout</string>
				<key>surface</key><string>panel.item</string>
				<key>group</key><string>9_plugins</string>
			</dict>
		</array>
	</dict>
</dict>
</plist>
