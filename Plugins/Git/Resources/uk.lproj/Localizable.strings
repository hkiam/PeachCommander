"Undo" = "Відмінити";
"Undo the rewrite of the commit messages?" = "Відмінити переписування повідомлень комітів?";
"Undone: %@ are back on the old commits." = "Відмінено: %@ знову на старих комітах.";
"Was: %@" = "Було: %@";
"Whole words" = "Цілі слова";
"edited" = "змінено";
"in %lld commit(s)" = "у %lld коміт(ах)";
"left as it is" = "залишено як є";
"pushed." = "надіслано.";
"%@ still has the old commits. Force-push the rewritten branches first; removing the old commits before that would make the force-push impossible." = "%@ досі містить старі коміти. Спершу примусово надішліть переписані гілки; якщо видалити старі коміти раніше, примусове надсилання стане неможливим.";
