/* Phase 10: commit messages changed after the fact */
"%@ (current branch)" = "%@ (поточна гілка)";
"%@ moved since the rewrite. Undoing would throw away the newer commits, so nothing was changed." = "Після переписування змістилося: %@. Відміна викинула б новіші коміти, тому нічого не змінено.";
"%@ moved while the messages were being rewritten. Nothing was changed; try again." = "Поки повідомлення переписувалися, змістилося: %@. Нічого не змінено; спробуйте ще раз.";
"%@ still has the old commits: force-push to replace them." = "%@ ще має старі коміти: замініть їх примусовим надсиланням.";
"%lld commits could not be signed again." = "Не вдалося знову підписати комітів: %lld.";
"%lld commits get new hashes: the %lld changed ones and every commit after them on the branches below." = "Нові хеші отримають комітів: %1$lld — %2$lld змінених і кожен коміт після них у гілках нижче.";
"%lld commits rewritten; moved: %@." = "Переписано комітів: %1$lld; переміщено: %2$@.";
"%lld commits, %lld matches" = "Комітів: %1$lld, збігів: %2$lld";
"%lld messages will change. Every later commit is rewritten with them; files and the working tree are not touched." = "Зміниться повідомлень: %lld. Кожен пізніший коміт буде переписано разом із ними; файли й робочу копію не буде зачеплено.";
"%lld of the commits are not on a chosen branch and were left as they are." = "Комітів, що не лежать на жодній вибраній гілці й залишилися як є: %lld.";
"%lld of them are signed and lose their signature (Settings ▸ Git ▸ Sign commits signs them again)." = "Підписаних серед них: %lld, вони втратять підпис (Налаштування ▸ Git ▸ Підписувати коміти підпише їх знову).";
"%lld of them are signed; they are signed again with your key." = "Підписаних серед них: %lld; їх буде знову підписано вашим ключем.";
"%lld old commits are still in this repository." = "У цьому репозиторії ще є старих комітів: %lld.";
"%lld possible secrets found" = "Знайдено можливих секретів: %lld";
"%lld replaced" = "Замінено: %lld";
"%lld signatures removed." = "Видалено підписів: %lld.";
"(subject unchanged, the rest of the message changes)" = "(тема без змін, змінюється решта повідомлення)";
"A branch that was force-pushed in between stays rewritten at its remote." = "Гілка, яку тим часом надіслали примусово, залишиться переписаною у своєму віддаленому репозиторії.";
"A commit could not be written. Nothing was changed." = "Не вдалося записати коміт. Нічого не змінено.";
"A merge, rebase, cherry-pick or bisect is in progress. Finish or abort it first." = "Триває merge, rebase, cherry-pick або bisect. Спершу завершіть або перервіть його.";
"A stash or another worktree may still hold them." = "Їх може ще утримувати stash або інший worktree.";
"A stash was made on one of these commits; it stays on the old one." = "На одному з цих комітів було створено stash; він залишиться на старому.";
"After the change — can be edited" = "Після зміни — можна редагувати";
"All branches and tags" = "Усі гілки й теґи";
"Already pushed to %@: the branches will have to be force-pushed afterwards, and anyone who fetched them still has the old commits." = "Уже надіслано до %@: гілки потім доведеться надіслати примусово, а в усіх, хто їх отримав, залишаться старі коміти.";
