<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key><string>Markdown</string>
	<key>CFBundleExecutable</key><string>Markdown</string>
	<key>CFBundlePackageType</key><string>BNDL</string>
	<key>CFBundleShortVersionString</key><string>1.0</string>
	<key>CFBundleVersion</key><string>1</string>
	<key>PCPluginType</key><string>plx</string>
	<key>PCPluginAPIVersion</key><integer>1</integer>
	<key>PCPluginName</key><string>Markdown and HTML</string>
	<key>PCPluginMinHostVersion</key><integer>1</integer>
	<!-- The Markdown half of both keys is PCFoundation's MarkdownFileType set, written out here
	     because a manifest cannot compute. ListGetDetectString builds the string this plugin
	     actually claims by from the same set at call time, so these two are the copy — if they ever
	     disagree, this file is the one that is wrong. `mdx` is in it because the outline and the
	     Format button have always treated it as Markdown. -->
	<key>PCPluginExtensions</key>
	<array>
		<string>markdown</string><string>md</string><string>mdown</string>
		<string>mdwn</string><string>mdx</string><string>mkd</string><string>mkdn</string>
		<string>html</string><string>htm</string><string>xhtml</string>
	</array>
	<key>PCPluginDetectString</key>
	<string>EXT="MARKDOWN" | EXT="MD" | EXT="MDOWN" | EXT="MDWN" | EXT="MDX" | EXT="MKD" | EXT="MKDN" | EXT="HTM" | EXT="HTML" | EXT="XHTML"</string>
	<!-- Contribution facet: this plugin's own page in Settings. Not a page built into the host —
	     the plugin is removable, and a host page for something that may not be installed is dead
	     UI, while settings in the host's own file would outlive the plugin that meant something
	     by them. They live in <configRoot>/markdown.ini instead. -->
	<key>PCContributions</key>
	<dict>
		<!-- Export facet: the renderer this plugin owns, offered as a file action. The application
		     has no other renderer for .md and .html, so this is the only place a faithful PDF of
		     one can come from — a second rendering (QuickLook, AppKit's HTML reader) would not
		     look like what F3 shows. The `when` list is the same extension set as
		     PCPluginExtensions above; a `when` the host cannot evaluate fails closed, so this
		     names the extensions rather than asking the plugin, which the host will not load to
		     build a menu.

		     `panelScheme == 'file'` is load-bearing and not belt-and-braces: inside an archive or
		     on a mounted drive the cursor's path is a VFS path with nothing behind it on disk, so
		     the export could neither read the document nor put a PDF beside it. Without this the
		     entry offered itself over a README in an opened .zip and answered that nothing was
		     selected. Greyed out there is the honest answer. -->
		<key>commands</key>
		<array>
			<dict>
				<key>category</key><string>Commands</string>
				<key>id</key><string>plugin.markdown.pdf</string>
				<key>title</key><string>Export to PDF…</string>
			</dict>
		</array>
		<key>menus</key>
		<array>
			<dict>
				<key>command</key><string>plugin.markdown.pdf</string>
				<key>group</key><string>2_tools</string>
				<key>menu</key><string>Commands</string>
				<key>order</key><integer>121</integer>
				<key>when</key><string>panelScheme == 'file' &amp;&amp; cursorExt in ('markdown', 'md', 'mdown', 'mdwn', 'mdx', 'mkd', 'mkdn', 'html', 'htm', 'xhtml')</string>
			</dict>
		</array>
		<key>contextMenus</key>
		<array>
			<dict>
				<key>command</key><string>plugin.markdown.pdf</string>
				<key>group</key><string>9_plugins</string>
				<key>surface</key><string>panel.item</string>
				<key>when</key><string>panelScheme == 'file' &amp;&amp; cursorExt in ('markdown', 'md', 'mdown', 'mdwn', 'mdx', 'mkd', 'mkdn', 'html', 'htm', 'xhtml')</string>
			</dict>
		</array>
		<key>views</key>
		<array>
			<dict>
				<key>id</key><string>plugin.markdown.settings</string>
				<key>container</key><string>settings</string>
				<key>title</key><string>Markdown</string>
			</dict>
		</array>
	</dict>
	<!-- No PCPluginEnabledByDefault: this plugin is the ONLY renderer for Markdown and HTML —
	     the application gave the formats up entirely — so shipping it switched off would take a
	     feature away from every new installation. Turning it off is a choice a reader can make,
	     and then .md and .html are shown as text, with the outline still working. -->
</dict>
</plist>
