    "Put the cursor on a .crc or .001 part file.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Umístěte kurzor na soubor .crc nebo části .001."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Placer markøren på en .crc- eller .001-delfil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze den Cursor auf eine .crc- oder .001-Teildatei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca el cursor sobre un archivo de parte .crc o .001."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez le curseur sur un fichier de partie .crc ou .001."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Helyezze a kurzort egy .crc vagy .001 darabfájlra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posiziona il cursore su un file parziale .crc o .001."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ".crc 또는 .001 부분 파일에 커서를 놓으십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sett markøren på en .crc- eller .001-delfil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaats de cursor op een .crc- of .001-deelbestand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw kursor na pliku części .crc lub .001."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poziționați cursorul pe un fișier de parte .crc sau .001."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите курсор на файл части .crc или .001."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Umiestnite kurzor na súbor časti .crc alebo .001."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Postavite kazalec na datoteko .crc ali del .001."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Placera markören på en .crc- eller .001-delfil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведіть курсор на файл частини .crc або .001."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将光标置于 .crc 或 .001 分卷文件上。"
          }
        }
      }
    },
