    "%@ is a compressed archive — files cannot be added to it without repacking it.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je komprimovaný archiv — soubory do něj nelze přidat bez opětovného zabalení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er et komprimeret arkiv — filer kan ikke tilføjes uden at pakke det om."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist ein komprimiertes Archiv — Dateien lassen sich nicht hinzufügen, ohne es neu zu packen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ es un archivo comprimido: no se pueden añadir archivos sin volver a comprimirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est une archive compressée — impossible d’y ajouter des fichiers sans la recompresser."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ tömörített archívum — fájlokat nem lehet hozzáadni újracsomagolás nélkül."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è un archivio compresso: non è possibile aggiungere file senza ricomprimerlo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 압축된 아카이브입니다 — 다시 압축하지 않고는 파일을 추가할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er et komprimert arkiv — filer kan ikke legges til uten å pakke det om."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is een gecomprimeerd archief — bestanden toevoegen kan niet zonder het opnieuw in te pakken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ to archiwum skompresowane — nie można dodać plików bez ponownego spakowania."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ este o arhivă comprimată — fișierele nu pot fi adăugate fără reîmpachetare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — сжатый архив: добавить файлы без переупаковки нельзя."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je komprimovaný archív — súbory doň nemožno pridať bez opätovného zabalenia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je stisnjen arhiv — datotek ni mogoče dodati brez ponovnega pakiranja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ är ett komprimerat arkiv – filer kan inte läggas till utan att packa om det."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — стиснений архів: додати файли без перепакування неможливо."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是压缩归档 — 不重新打包便无法向其中添加文件。"
          }
        }
      }
    },
