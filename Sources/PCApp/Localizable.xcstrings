    "Active mode cannot work through a proxy — the server has no way to open the data connection back. Switch passive mode on.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivní režim nemůže fungovat přes proxy — server nemá jak otevřít datové spojení zpět. Zapněte pasivní režim."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiv tilstand kan ikke fungere gennem en proxy — serveren har ingen mulighed for at åbne dataforbindelsen tilbage. Slå passiv tilstand til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiver Modus kann nicht über einen Proxy funktionieren – der Server kann die Datenverbindung nicht zurück aufbauen. Schalte den passiven Modus ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo activo no puede funcionar a través de un proxy: el servidor no tiene forma de abrir la conexión de datos de vuelta. Activa el modo pasivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode actif ne peut pas fonctionner via un proxy — le serveur n’a aucun moyen d’ouvrir la connexion de données en retour. Activez le mode passif."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az aktív mód nem működhet proxyn keresztül — a kiszolgáló nem tudja visszafelé megnyitni az adatkapcsolatot. Kapcsolja be a passzív módot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modalità attiva non può funzionare attraverso un proxy — il server non ha modo di aprire la connessione dati di ritorno. Attiva la modalità passiva."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 모드는 프록시를 통해 작동할 수 없습니다. 서버가 데이터 연결을 되돌려 열 방법이 없습니다. 수동 모드를 켜세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiv modus kan ikke fungere gjennom en proxy — serveren har ingen måte å åpne dataforbindelsen tilbake på. Slå på passiv modus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Actieve modus kan niet via een proxy werken — de server kan de dataverbinding niet terug opzetten. Schakel passieve modus in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb aktywny nie może działać przez proxy — serwer nie ma jak otworzyć połączenia danych z powrotem. Włącz tryb pasywny."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modul activ nu poate funcționa printr-un proxy — serverul nu are cum să deschidă conexiunea de date înapoi. Activați modul pasiv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активный режим не работает через прокси — серверу некуда открывать обратное соединение данных. Включите пассивный режим."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktívny režim nemôže fungovať cez proxy — server nemá ako otvoriť dátové spojenie späť. Zapnite pasívny režim."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivni način ne more delovati prek posrednika — strežnik ne more odpreti podatkovne povezave nazaj. Vklopite pasivni način."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivt läge kan inte fungera genom en proxy — servern har inget sätt att öppna dataanslutningen tillbaka. Slå på passivt läge."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Активний режим не працює через проксі — серверу нікуди відкривати зворотне з’єднання даних. Увімкніть пасивний режим."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主动模式无法通过代理工作 — 服务器无法反向建立数据连接。请开启被动模式。"
          }
        }
      }
    },
