    "Nothing here can be folded.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zde není co sbalit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Her er intet at folde sammen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier lässt sich nichts falten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí no hay nada que plegar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à replier ici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Itt nincs mit összecsukni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui non c'è nulla da comprimere."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에는 접을 것이 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Her er ingenting å folde sammen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier is niets in te klappen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma tu czego zwinąć."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aici nu este nimic de restrâns."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь нечего свернуть."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu nie je čo zbaliť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ni ničesar za strniti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Här finns inget att fälla in."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут нічого згортати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里没有可折叠的内容。"
          }
        }
      }
    },
    "Nothing here is on a removable volume.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zde nic není na vyměnitelném svazku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet her ligger på en flytbar disk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier liegt nichts auf einem Wechselmedium."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí no hay nada en un volumen extraíble."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ici ne se trouve sur un volume amovible."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Itt semmi sem található cserélhető köteten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui non c’è nulla su un volume rimovibile."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에는 이동식 볼륨에 있는 항목이 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting her ligger på et flyttbart volum."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier staat niets op een verwisselbaar volume."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic tutaj nie znajduje się na woluminie wymiennym."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic de aici nu se află pe un volum amovibil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь ничего нет на съёмном томе."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič tu nie je na vymeniteľnom zväzku."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tukaj ni ničesar na izmenljivem nosilcu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget här ligger på en flyttbar volym."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут нічого немає на знімному томі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里没有任何内容位于可移除宗卷上。"
          }
        }
      }
    },
