            "value": "Alleen nieuwere bestanden"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko nowsze pliki"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar fișiere mai noi"
          }
        },
        "ru": {
