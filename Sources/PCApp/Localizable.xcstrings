    "List folders that contain nothing at all — including invisible entries, so a folder holding only a .DS_Store or a .git does not count as empty. Files are not listed.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypíše složky, které neobsahují vůbec nic — ani neviditelné položky, takže složka jen s .DS_Store nebo .git se za prázdnou nepovažuje. Soubory se nevypisují."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser mapper, der slet ikke indeholder noget — heller ikke usynlige emner, så en mappe med kun en .DS_Store eller en .git tæller ikke som tom. Filer vises ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Listet Ordner, die überhaupt nichts enthalten — auch keine unsichtbaren Einträge, sodass ein Ordner mit nur einer .DS_Store oder einem .git nicht als leer gilt. Dateien werden nicht gelistet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista las carpetas que no contienen nada en absoluto, incluidas las entradas invisibles: una carpeta con solo un .DS_Store o un .git no cuenta como vacía. No se listan archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste les dossiers qui ne contiennent rien du tout — y compris les entrées invisibles, de sorte qu’un dossier ne contenant qu’un .DS_Store ou un .git n’est pas vide. Les fichiers ne sont pas listés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Azokat a mappákat listázza, amelyek egyáltalán semmit sem tartalmaznak — a láthatatlan bejegyzéseket sem, így a csak .DS_Store-t vagy .git-et tartalmazó mappa nem számít üresnek. Fájlokat nem listáz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elenca le cartelle che non contengono nulla — comprese le voci invisibili, quindi una cartella con solo un .DS_Store o un .git non è vuota. I file non vengono elencati."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무것도 들어 있지 않은 폴더를 나열합니다. 보이지 않는 항목도 포함하므로 .DS_Store나 .git만 있는 폴더는 비어 있지 않습니다. 파일은 나열하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser mapper som ikke inneholder noe som helst — heller ikke usynlige elementer, så en mappe med bare en .DS_Store eller en .git regnes ikke som tom. Filer vises ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont mappen die helemaal niets bevatten — ook geen onzichtbare items, dus een map met alleen een .DS_Store of een .git telt niet als leeg. Bestanden worden niet getoond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wypisuje foldery, które nie zawierają zupełnie niczego — także niewidocznych wpisów, więc folder z samym .DS_Store lub .git nie liczy się jako pusty. Pliki nie są wypisywane."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Listează dosarele care nu conțin absolut nimic — nici intrări invizibile, așa că un dosar cu doar un .DS_Store sau un .git nu este considerat gol. Fișierele nu sunt listate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает папки, в которых нет вообще ничего — включая невидимые элементы, поэтому папка с одним лишь .DS_Store или .git пустой не считается. Файлы не показываются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypíše priečinky, ktoré neobsahujú vôbec nič — ani neviditeľné položky, takže priečinok len s .DS_Store alebo .git sa za prázdny nepovažuje. Súbory sa nevypisujú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Našteje mape, ki ne vsebujejo prav ničesar — tudi nevidnih vnosov ne, zato mapa zgolj z .DS_Store ali .git ne velja za prazno. Datoteke niso naštete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar mappar som inte innehåller något alls — inte heller osynliga poster, så en mapp med bara en .DS_Store eller en .git räknas inte som tom. Filer visas inte."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує теки, у яких немає геть нічого — зокрема невидимих записів, тож тека лише з .DS_Store або .git порожньою не вважається. Файли не показуються."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列出完全不含任何内容的文件夹 — 包括不可见项，因此只含 .DS_Store 或 .git 的文件夹不算空。不列出文件。"
          }
        }
      }
    },
