    "Nothing is selected — applies to the whole document.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic není vybráno — platí pro celý dokument."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet er markeret — gælder for hele dokumentet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts ausgewählt — gilt für das ganze Dokument."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada seleccionado: se aplica a todo el documento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est sélectionné — s’applique à tout le document."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs kijelölés — a teljes dokumentumra érvényes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna selezione — si applica a tutto il documento."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택된 내용이 없습니다 — 문서 전체에 적용됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting er valgt — gjelder hele dokumentet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets geselecteerd — geldt voor het hele document."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie jest zaznaczone — dotyczy całego dokumentu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu este selectat nimic — se aplică întregului document."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не выделено — применяется ко всему документу."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
