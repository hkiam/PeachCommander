    "Choose which application opens each file type. Leave blank to use the built-in viewer (F3) or editor (F4).": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte, která aplikace otevírá jednotlivé typy souborů. Ponechte prázdné pro použití vestavěného prohlížeče (F3) nebo editoru (F4)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg, hvilket program der åbner hver filtype. Lad feltet være tomt for at bruge den indbyggede fremviser (F3) eller editor (F4)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie, welche Anwendung jeden Dateityp öffnet. Leer lassen, um den integrierten Betrachter (F3) bzw. Editor (F4) zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué aplicación abre cada tipo de archivo. Déjalo en blanco para usar el visor (F3) o el editor (F4) integrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez l’application qui ouvre chaque type de fichier. Laissez vide pour utiliser la visionneuse (F3) ou l’éditeur (F4) intégré."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassza ki, melyik alkalmazás nyissa meg az egyes fájltípusokat. Hagyja üresen a beépített megjelenítő (F3) vagy szerkesztő (F4) használatához."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli quale applicazione apre ciascun tipo di file. Lascia vuoto per usare il visualizzatore (F3) o l’editor (F4) integrati."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 파일 형식을 여는 응용 프로그램을 선택하십시오. 비워 두면 내장 뷰어(F3) 또는 편집기(F4)를 사용합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg hvilket program som åpner hver filtype. La stå tomt for å bruke den innebygde viseren (F3) eller redigereren (F4)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies welk programma elk bestandstype opent. Laat leeg om de ingebouwde weergave (F3) of editor (F4) te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz aplikację otwierającą każdy typ pliku. Pozostaw puste, aby użyć wbudowanej przeglądarki (F3) lub edytora (F4)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege aplicația care deschide fiecare tip de fișier. Lasă necompletat pentru a folosi vizualizatorul (F3) sau editorul (F4) încorporat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, какое приложение открывает каждый тип файлов. Оставьте пустым, чтобы использовать встроенный просмотрщик (F3) или редактор (F4)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte, ktorá aplikácia otvára jednotlivé typy súborov. Ponechajte prázdne na použitie vstavaného prehliadača (F3) alebo editora (F4)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite, katera aplikacija odpre posamezno vrsto datoteke. Pustite prazno za uporabo vgrajenega pregledovalnika (F3) ali urejevalnika (F4)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj vilket program som öppnar varje filtyp. Lämna tomt för att använda den inbyggda visaren (F3) eller redigeraren (F4)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть, яка програма відкриває кожен тип файлів. Залиште порожнім, щоб використати вбудований переглядач (F3) або редактор (F4)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择用哪个应用程序打开各文件类型。留空则使用内置查看器（F3）或编辑器（F4）。"
          }
        }
      }
    },
