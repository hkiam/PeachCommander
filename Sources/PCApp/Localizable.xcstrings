    "No accessible process has %@ open. Other users' processes may need elevated privileges.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádný přístupný proces nemá %@ otevřený. Procesy jiných uživatelů mohou vyžadovat zvýšená oprávnění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen tilgængelig proces har %@ åben. Andre brugeres processer kan kræve forhøjede rettigheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein zugänglicher Prozess hat %@ geöffnet. Prozesse anderer Benutzer benötigen ggf. erhöhte Rechte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún proceso accesible tiene %@ abierto. Los procesos de otros usuarios pueden requerir privilegios elevados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun processus accessible n’a ouvert %@. Les processus d’autres utilisateurs peuvent nécessiter des privilèges élevés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyetlen elérhető folyamat sem tartja nyitva ezt: %@. Más felhasználók folyamataihoz emelt szintű jogosultság lehet szükséges."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun processo accessibile ha %@ aperto. I processi di altri utenti potrebbero richiedere privilegi elevati."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 열고 있는 접근 가능한 프로세스가 없습니다. 다른 사용자의 프로세스에는 상승된 권한이 필요할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen tilgjengelig prosess har %@ åpen. Andre brukeres prosesser kan kreve forhøyede rettigheter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen toegankelijk proces heeft %@ geopend. Processen van andere gebruikers vereisen mogelijk verhoogde rechten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żaden dostępny proces nie ma otwartego %@. Procesy innych użytkowników mogą wymagać podwyższonych uprawnień."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Niciun proces accesibil nu are %@ deschis. Procesele altor utilizatori pot necesita privilegii ridicate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни один доступный процесс не открыл %@. Для процессов других пользователей могут потребоваться повышенные привилегии."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Žiadny prístupný proces nemá otvorený %@. Procesy iných používateľov môžu vyžadovať vyššie práva."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noben dostopen proces nima odprte datoteke %@. Procesi drugih uporabnikov morda potrebujejo povišane pravice."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen åtkomlig process har %@ öppen. Andra användares processer kan kräva förhöjd behörighet."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоден доступний процес не відкрив %@. Для процесів інших користувачів можуть знадобитися підвищені права."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可访问的进程打开 %@。其他用户的进程可能需要提升权限。"
          }
        }
      }
    },
    "No accessible process is using port %d. System ports may need elevated privileges.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Port %d nepoužívá žádný přístupný proces. Systémové porty mohou vyžadovat zvýšená oprávnění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen tilgængelig proces bruger port %d. Systemporte kan kræve forhøjede rettigheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein zugänglicher Prozess belegt Port %d. Systemports benötigen ggf. erhöhte Rechte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún proceso accesible está usando el puerto %d. Los puertos del sistema pueden requerir privilegios elevados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun processus accessible n’utilise le port %d. Les ports système peuvent nécessiter des privilèges élevés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyetlen elérhető folyamat sem használja a(z) %d portot. A rendszerportokhoz emelt szintű jogosultság lehet szükséges."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun processo accessibile sta usando la porta %d. Le porte di sistema potrebbero richiedere privilegi elevati."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포트 %d을(를) 사용하는 접근 가능한 프로세스가 없습니다. 시스템 포트에는 상승된 권한이 필요할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen tilgjengelig prosess bruker port %d. Systemporter kan kreve forhøyede rettigheter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen toegankelijk proces gebruikt poort %d. Systeempoorten vereisen mogelijk verhoogde rechten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żaden dostępny proces nie używa portu %d. Porty systemowe mogą wymagać podwyższonych uprawnień."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Niciun proces accesibil nu folosește portul %d. Porturile de sistem pot necesita privilegii ridicate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни один доступный процесс не использует порт %d. Для системных портов могут потребоваться повышенные привилегии."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Žiadny prístupný proces nepoužíva port %d. Systémové porty môžu vyžadovať vyššie práva."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrata %d ne uporablja noben dostopen proces. Sistemska vrata morda potrebujejo povišane pravice."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen åtkomlig process använder port %d. Systemportar kan kräva förhöjd behörighet."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоден доступний процес не використовує порт %d. Для системних портів можуть знадобитися підвищені права."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可访问的进程正在使用端口 %d。系统端口可能需要提升权限。"
          }
        }
      }
    },
