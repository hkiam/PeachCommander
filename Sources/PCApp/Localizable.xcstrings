    "Synchronizing an archive with a server is not supported.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizace archivu se serverem není podporována."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkronisering af et arkiv med en server understøttes ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Synchronisieren eines Archivs mit einem Server wird nicht unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se admite sincronizar un archivo comprimido con un servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation d’une archive avec un serveur n’est pas prise en charge."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Archívum és kiszolgáló szinkronizálása nem támogatott."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
