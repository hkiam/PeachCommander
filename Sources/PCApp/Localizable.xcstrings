        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elveti a módosításokat és újratölti lemezről?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorare le modifiche e ricaricare dal disco?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항을 버리고 디스크에서 다시 불러오시겠습니까?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forkaste endringer og laste inn på nytt fra disk?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzigingen verwerpen en opnieuw laden vanaf schijf?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odrzucić zmiany i wczytać ponownie z dysku?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Renunțați la modificări și reîncărcați de pe disc?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить изменения и перезагрузить с диска?"
