    },
    "Files cannot be added to a “%@” archive; this app only reads that format.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Do archivu „%@“ nelze přidávat soubory; tato aplikace tento formát pouze čte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der kan ikke tilføjes filer til et “%@”-arkiv; denne app læser kun det format."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu einem „%@“-Archiv lassen sich keine Dateien hinzufügen; diese App liest dieses Format nur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden añadir archivos a un archivo «%@»; esta app solo lee ese formato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ajouter des fichiers à une archive « %@ » ; cette app ne fait que lire ce format."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy „%@” archívumhoz nem lehet fájlokat hozzáadni; ez az alkalmazás csak olvassa ezt a formátumot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è possibile aggiungere file a un archivio «%@»; questa app legge soltanto quel formato."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 아카이브에는 파일을 추가할 수 없습니다. 이 앱은 해당 형식을 읽기만 합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det kan ikke legges filer i et «%@»-arkiv; denne appen bare leser det formatet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aan een ‘%@’-archief kunnen geen bestanden worden toegevoegd; deze app leest dat formaat alleen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do archiwum „%@” nie można dodawać plików; ta aplikacja tylko odczytuje ten format."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu se pot adăuga fișiere într-o arhivă „%@”; această aplicație doar citește acest format."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В архив «%@» нельзя добавлять файлы; это приложение только читает такой формат."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Do archívu „%@“ nemožno pridávať súbory; táto aplikácia tento formát iba číta."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V arhiv »%@« ni mogoče dodajati datotek; ta aplikacija ta zapis samo bere."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det går inte att lägga till filer i ett ”%@”-arkiv; appen kan bara läsa det formatet."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До архіву «%@» не можна додавати файли; цей застосунок лише читає такий формат."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法向“%@”归档添加文件；本应用只能读取该格式。"
          }
        }
      }
    },
