    "%lld item(s) could not be copied (permission denied). Copy them with administrator privileges?": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld položek se nepodařilo zkopírovat (přístup odepřen). Zkopírovat je s právy správce?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld emne(r) kunne ikke kopieres (adgang nægtet). Kopiér dem med administratorrettigheder?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Objekt(e) konnten nicht kopiert werden (Zugriff verweigert). Mit Administratorrechten kopieren?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron copiar %lld elemento(s) (permiso denegado). ¿Copiarlos con privilegios de administrador?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld élément(s) n’ont pas pu être copiés (accès refusé). Les copier avec des privilèges d’administrateur ?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld elemet nem sikerült másolni (hozzáférés megtagadva). Másolás rendszergazdai jogosultsággal?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile copiare %lld elemento/i (permesso negato). Copiarli con privilegi di amministratore?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개 항목을 복사할 수 없습니다(권한 거부됨). 관리자 권한으로 복사하시겠습니까?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld element(er) kunne ikke kopieres (tilgang nektet). Kopiere dem med administratorrettigheter?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld item(s) konden niet worden gekopieerd (toegang geweigerd). Kopiëren met beheerdersrechten?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się skopiować %lld element(ów) (odmowa dostępu). Skopiować je z uprawnieniami administratora?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld element(e) nu au putut fi copiate (acces refuzat). Le copiați cu privilegii de administrator?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось скопировать %lld объект(ов) (доступ запрещён). Скопировать их с правами администратора?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld položiek sa nepodarilo skopírovať (prístup zamietnutý). Skopírovať ich s právami správcu?"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld predmetov ni bilo mogoče kopirati (dostop zavrnjen). Ali jih želite kopirati s skrbniškimi pravicami?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld objekt kunde inte kopieras (åtkomst nekad). Kopiera dem med administratörsbehörighet?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося скопіювати %lld об’єкт(ів) (доступ заборонено). Скопіювати їх із правами адміністратора?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法复制 %lld 个项目（权限被拒绝）。是否以管理员权限复制？"
          }
        }
      }
    },
    "%lld item(s) could not be deleted (permission denied). Delete them with administrator privileges?": {
