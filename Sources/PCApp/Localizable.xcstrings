          "stringUnit": {
            "state": "translated",
            "value": "(dette format tillader kommentarer, som valideringen ikke læser)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "(dieses Format erlaubt Kommentare, die die Prüfung nicht liest)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "(este formato permite comentarios, que el validador no lee)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "(ce format autorise les commentaires, que le validateur ne lit pas)"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "(ez a formátum megengedi a megjegyzéseket, amelyeket az ellenőrzés nem olvas)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "(questo formato consente i commenti, che il validatore non legge)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "(이 형식은 주석을 허용하지만 검사기는 주석을 읽지 않습니다)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "(dette formatet tillater kommentarer, som valideringen ikke leser)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "(dit formaat staat commentaar toe, dat de validatie niet leest)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "(ten format dopuszcza komentarze, których sprawdzanie nie czyta)"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "(acest format permite comentarii, pe care validarea nu le citește)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "(этот формат допускает комментарии, которые проверка не читает)"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "(tento formát povoľuje komentáre, ktoré kontrola nečíta)"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "(ta oblika dovoljuje komentarje, ki jih preverjanje ne bere)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "(det här formatet tillåter kommentarer, som valideringen inte läser)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "(цей формат допускає коментарі, яких перевірка не читає)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "（此格式允许注释，而校验不读取注释）"
          }
        }
      }
    },
