    "Let the assistant run shell commands (asks every time)": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolit asistentovi spouštět příkazy shellu (vždy se zeptá)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lad assistenten køre shell-kommandoer (spørger hver gang)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Assistenz darf Shell-Befehle ausführen (fragt jedes Mal)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que el asistente ejecute comandos de shell (pregunta cada vez)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
