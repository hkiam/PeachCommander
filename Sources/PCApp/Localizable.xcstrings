    "Applies to the built-in text editor, the hex editor and the compare window. The copy is written next to the file as “name.bak”.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Platí pro vestavěný textový editor, hexadecimální editor a okno porovnání. Kopie se zapíše vedle souboru jako „name.bak”."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gælder det indbyggede tekstredigeringsprogram, hex-editoren og sammenligningsvinduet. Kopien skrives ved siden af filen som ”name.bak”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für den integrierten Texteditor, den Hex-Editor und das Vergleichsfenster. Die Kopie wird neben der Datei als „name.bak“ abgelegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica al editor de texto integrado, al editor hexadecimal y a la ventana de comparación. La copia se escribe junto al archivo como «name.bak»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique à l’éditeur de texte intégré, à l’éditeur hexadécimal et à la fenêtre de comparaison. La copie est écrite à côté du fichier sous le nom « name.bak »."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beépített szövegszerkesztőre, a hexadecimális szerkesztőre és az összehasonlító ablakra érvényes. A másolat a fájl mellé kerül „name.bak” néven."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale per l’editor di testo integrato, l’editor esadecimale e la finestra di confronto. La copia viene scritta accanto al file come «name.bak»."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내장 텍스트 편집기, 16진수 편집기, 비교 창에 적용됩니다. 사본은 파일 옆에 “name.bak”으로 기록됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjelder det innebygde tekstredigeringsprogrammet, hex-editoren og sammenligningsvinduet. Kopien skrives ved siden av filen som «name.bak»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geldt voor de ingebouwde teksteditor, de hex-editor en het vergelijkvenster. De kopie wordt naast het bestand geschreven als ‘name.bak’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotyczy wbudowanego edytora tekstu, edytora szesnastkowego i okna porównania. Kopia jest zapisywana obok pliku jako „name.bak”."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplică editorului de text încorporat, editorului hexazecimal și ferestrei de comparare. Copia este scrisă lângă fișier ca „name.bak”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Относится к встроенному текстовому редактору, шестнадцатеричному редактору и окну сравнения. Копия записывается рядом с файлом как «name.bak»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Platí pre vstavaný textový editor, hexadecimálny editor a okno porovnania. Kópia sa zapíše vedľa súboru ako „name.bak”."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Velja za vgrajeni urejevalnik besedila, urejevalnik šestnajstiških vrednosti in okno primerjave. Kopija se zapiše ob datoteko kot „name.bak“."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gäller den inbyggda textredigeraren, hex-redigeraren och jämförelsefönstret. Kopian skrivs intill filen som ”name.bak”."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стосується вбудованого текстового редактора, шістнадцяткового редактора та вікна порівняння. Копія записується поряд із файлом як «name.bak»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于内置文本编辑器、十六进制编辑器和比较窗口。副本以“name.bak”的名称写在文件旁边。"
          }
        }
      }
    },
