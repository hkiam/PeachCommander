    "Open an FTP connection first (the active panel must be browsing an FTP site).": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejprve otevřete připojení FTP (aktivní panel musí procházet server FTP)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn en FTP-forbindelse først (det aktive panel skal gennemse et FTP-sted)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst eine FTP-Verbindung öffnen (das aktive Panel muss eine FTP-Site anzeigen)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre primero una conexión FTP (el panel activo debe estar explorando un sitio FTP)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez d’abord une connexion FTP (le panneau actif doit parcourir un site FTP)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Először nyisson meg egy FTP-kapcsolatot (az aktív panelnek egy FTP-helyet kell böngésznie)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri prima una connessione FTP (il pannello attivo deve esplorare un sito FTP)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP 연결을 먼저 여십시오(활성 패널이 FTP 사이트를 탐색 중이어야 함)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne en FTP-tilkobling først (det aktive panelet må bla i et FTP-nettsted)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open eerst een FTP-verbinding (het actieve paneel moet een FTP-site doorbladeren)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw otwórz połączenie FTP (aktywny panel musi przeglądać witrynę FTP)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschideți mai întâi o conexiune FTP (panoul activ trebuie să răsfoiască un sit FTP)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала откройте FTP-подключение (активная панель должна отображать FTP-сервер)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprv otvorte FTP pripojenie (aktívny panel musí prehliadať FTP server)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprej odprite povezavo FTP (aktivni panel mora brskati po mestu FTP)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna en FTP-anslutning först (den aktiva panelen måste visa en FTP-plats)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спочатку відкрийте з’єднання FTP (активна панель має переглядати сайт FTP)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先打开一个 FTP 连接（活动面板必须正在浏览 FTP 站点）。"
          }
        }
      }
    },
