            "value": "Klawisze funkcyjne trafiają do terminala."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastele funcționale merg în terminal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Функциональные клавиши уходят в терминал."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkčné klávesy idú do terminálu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkcijske tipke gredo v terminal."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktionstangenterna går till terminalen."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Функціональні клавіші йдуть у термінал."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "功能键将发送到终端。"
          }
        }
      }
    },
    "The host key for %@ does not match the one on file. This can mean the server was rebuilt — or that something is impersonating it. Connection refused.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klíč hostitele %@ neodpovídá uloženému. Může to znamenat, že byl server znovu nasazen — nebo že se za něj něco vydává. Spojení odmítnuto."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Værtsnøglen for %@ svarer ikke til den registrerede. Det kan betyde, at serveren er sat op på ny — eller at noget udgiver sig for at være den. Forbindelsen afvist."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Host-Schlüssel von %@ stimmt nicht mit dem hinterlegten überein. Das kann bedeuten, dass der Server neu aufgesetzt wurde — oder dass sich etwas als er ausgibt. Verbindung abgelehnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave del host de %@ no coincide con la registrada. Puede significar que el servidor se reinstaló — o que algo se está haciendo pasar por él. Conexión rechazada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé d’hôte de %@ ne correspond pas à celle enregistrée. Cela peut signifier que le serveur a été réinstallé — ou que quelque chose se fait passer pour lui. Connexion refusée."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gazdagépkulcsa nem egyezik a rögzítettel. Ez jelentheti, hogy a kiszolgálót újratelepítették — vagy hogy valami a nevében lép fel. A kapcsolat elutasítva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave host di %@ non corrisponde a quella registrata. Può significare che il server è stato reinstallato — o che qualcosa si sta spacciando per esso. Connessione rifiutata."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 호스트 키가 기록된 것과 일치하지 않습니다. 서버를 다시 구축했거나, 무언가가 서버를 사칭하고 있을 수 있습니다. 연결이 거부되었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertsnøkkelen for %@ stemmer ikke med den lagrede. Det kan bety at serveren er satt opp på nytt — eller at noe utgir seg for å være den. Tilkobling avvist."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De hostsleutel van %@ komt niet overeen met de opgeslagen sleutel. Dit kan betekenen dat de server opnieuw is opgezet — of dat iets zich voordoet als de server. Verbinding geweigerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucz hosta %@ nie zgadza się z zapisanym. Może to oznaczać, że serwer postawiono na nowo — albo że coś się pod niego podszywa. Połączenie odrzucone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheia gazdei pentru %@ nu corespunde celei înregistrate. Poate însemna că serverul a fost reinstalat — sau că ceva se dă drept el. Conexiune refuzată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ хоста %@ не совпадает с сохранённым. Это может означать, что сервер переустановлен — или что кто-то выдаёт себя за него. Соединение отклонено."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kľúč hostiteľa %@ nezodpovedá uloženému. Môže to znamenať, že server bol nasadený nanovo — alebo že sa zaňho niečo vydáva. Spojenie odmietnuté."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ključ gostitelja za %@ se ne ujema s shranjenim. To lahko pomeni, da je bil strežnik postavljen na novo — ali da se nekaj izdaja zanj. Povezava zavrnjena."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Värdnyckeln för %@ stämmer inte med den sparade. Det kan betyda att servern satts upp på nytt — eller att något utger sig för att vara den. Anslutningen nekad."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ хоста %@ не збігається зі збереженим. Це може означати, що сервер перевстановлено — або що хтось видає себе за нього. З’єднання відхилено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的主机密钥与已记录的不一致。这可能意味着服务器被重建 — 也可能有东西在冒充它。已拒绝连接。"
          }
        }
      }
    },
    "The name “%@” is used more than once.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Název „%@“ je použit více než jednou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Navnet “%@” bruges mere end én gang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name „%@“ wird mehrfach verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre “%@” se usa más de una vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom « %@ » est utilisé plusieurs fois."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) „%@” név egynél többször szerepel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome “%@” è usato più di una volta."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 이름이 두 번 이상 사용되었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Navnet «%@» brukes mer enn én gang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De naam “%@” wordt meer dan eens gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa „%@” jest użyta więcej niż raz."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numele „%@” este folosit de mai multe ori."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя «%@» используется более одного раза."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Názov „%@“ je použitý viac ako raz."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ime „%@“ je uporabljeno več kot enkrat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Namnet ”%@” används mer än en gång."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ім’я «%@» використано більше ніж один раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称 “%@” 被多次使用。"
          }
        }
      }
    },
    "The new language takes effect after you restart PeachCommander.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nový jazyk se projeví po restartování aplikace PeachCommander."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det nye sprog træder i kraft, når du genstarter PeachCommander."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neue Sprache wird wirksam, nachdem Sie PeachCommander neu starten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nuevo idioma se aplicará cuando reinicies PeachCommander."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nouvelle langue prend effet après le redémarrage de PeachCommander."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az új nyelv a PeachCommander újraindítása után lép életbe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La nuova lingua ha effetto dopo il riavvio di PeachCommander."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 언어는 PeachCommander를 다시 시작한 후에 적용됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det nye språket trer i kraft etter at du starter PeachCommander på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De nieuwe taal wordt van kracht nadat je PeachCommander opnieuw start."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowy język zostanie zastosowany po ponownym uruchomieniu PeachCommander."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Noua limbă are efect după ce reporniți PeachCommander."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новый язык вступит в силу после перезапуска PeachCommander."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nový jazyk sa prejaví po reštartovaní PeachCommander."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Novi jezik začne veljati po ponovnem zagonu PeachCommanderja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det nya språket börjar gälla efter att du startat om PeachCommander."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нова мова набуде чинності після перезапуску PeachCommander."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新语言将在你重新启动 PeachCommander 后生效。"
          }
        }
      }
    },
    "The result is too large for the clipboard — use Save instead.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výsledek je pro schránku příliš velký — místo toho použijte Uložit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultatet er for stort til udklipsholderen — brug Gem i stedet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ergebnis ist zu groß für die Zwischenablage – bitte stattdessen speichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado es demasiado grande para el portapapeles — usa Guardar en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat est trop volumineux pour le presse-papiers — utilisez plutôt Enregistrer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eredmény túl nagy a vágólaphoz — használja inkább a Mentést."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il risultato è troppo grande per gli appunti — usa invece Salva."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결과가 클립보드에 넣기에는 너무 큽니다 — 대신 저장을 사용하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultatet er for stort for utklippstavlen — bruk Lagre i stedet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het resultaat is te groot voor het klembord — gebruik in plaats daarvan Bewaren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wynik jest zbyt duży dla schowka — zamiast tego użyj opcji Zapisz."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezultatul este prea mare pentru clipboard — folosiți Salvează în schimb."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат слишком велик для буфера обмена — используйте «Сохранить»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Výsledok je príliš veľký pre schránku — namiesto toho použite Uložiť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezultat je prevelik za odložišče — namesto tega uporabite Shrani."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultatet är för stort för urklipp — använd Spara i stället."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат завеликий для буфера обміну — скористайтеся замість цього збереженням."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果对于剪贴板来说太大 — 请改用“存储”。"
          }
        }
      }
    },
    "The server stopped responding. The panel has returned to where you connected from; connect again to continue.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server přestal odpovídat. Panel se vrátil tam, odkud jste se připojili; pro pokračování se připojte znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren svarer ikke længere. Panelet er vendt tilbage til det sted, du oprettede forbindelse fra; opret forbindelse igen for at fortsætte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server antwortet nicht mehr. Das Panel ist dorthin zurückgekehrt, von wo aus Sie verbunden haben; verbinden Sie sich erneut, um fortzufahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor dejó de responder. El panel ha vuelto al lugar desde donde se conectó; vuelva a conectarse para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur ne répond plus. Le panneau est revenu à l’endroit d’où vous vous êtes connecté ; reconnectez-vous pour continuer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kiszolgáló nem válaszol. A panel visszatért oda, ahonnan csatlakozott; a folytatáshoz csatlakozzon újra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server ha smesso di rispondere. Il pannello è tornato al punto da cui ti sei connesso; riconnettiti per continuare."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 응답을 멈췄습니다. 패널이 연결을 시작한 위치로 돌아갔습니다. 계속하려면 다시 연결하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren svarer ikke lenger. Panelet har gått tilbake til der du koblet til fra; koble til på nytt for å fortsette."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server reageert niet meer. Het paneel is teruggekeerd naar waar u verbinding maakte; maak opnieuw verbinding om door te gaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer przestał odpowiadać. Panel wrócił do miejsca, z którego nawiązano połączenie; połącz się ponownie, aby kontynuować."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverul nu mai răspunde. Panoul a revenit la locul de unde v-ați conectat; conectați-vă din nou pentru a continua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер перестал отвечать. Панель вернулась туда, откуда было установлено соединение; подключитесь снова, чтобы продолжить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Server prestal odpovedať. Panel sa vrátil tam, odkiaľ ste sa pripojili; pre pokračovanie sa pripojte znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strežnik se ne odziva več. Pult se je vrnil tja, od koder ste se povezali; za nadaljevanje se znova povežite."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Servern slutade svara. Panelen har återgått till platsen du anslöt från; anslut igen för att fortsätta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер перестав відповідати. Панель повернулася туди, звідки було встановлено з’єднання; підключіться знову, щоб продовжити."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器停止响应。面板已返回到您连接时所在的位置；请重新连接以继续。"
          }
        }
      }
    },
    "The startup disk cannot be ejected.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spouštěcí disk nelze vysunout."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Startdisken kan ikke skubbes ud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Startvolume kann nicht ausgeworfen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El disco de arranque no se puede expulsar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque de démarrage ne peut pas être éjecté."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az indítólemez nem adható ki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disco di avvio non può essere espulso."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시동 디스크는 추출할 수 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppstartsdisken kan ikke løses ut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opstartschijf kan niet worden uitgeworpen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dysku startowego nie można wysunąć."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Discul de pornire nu poate fi scos."
          }
        },
        "ru": {
