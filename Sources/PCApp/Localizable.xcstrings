    "Sort, deduplicate, filter or trim the selected lines": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Setřídit, odduplikovat, filtrovat nebo očistit vybrané řádky"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorter, fjern dubletter, filtrer eller trim de markerede linjer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählte Zeilen sortieren, entdoppeln, filtern oder trimmen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordenar, quitar duplicados, filtrar o recortar las líneas seleccionadas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trier, dédupliquer, filtrer ou nettoyer les lignes sélectionnées"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kijelölt sorok rendezése, ismétlődések eltávolítása, szűrése vagy tisztítása"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordina, deduplica, filtra o ripulisci le righe selezionate"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 줄을 정렬, 중복 제거, 필터 또는 정리"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorter, fjern duplikater, filtrer eller trim de valgte linjene"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geselecteerde regels sorteren, ontdubbelen, filteren of opschonen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortuj, usuń duplikaty, filtruj lub oczyść zaznaczone wiersze"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortează, elimină duplicatele, filtrează sau curăță liniile selectate"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сортировать, убрать повторы, отфильтровать или очистить выделенные строки"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoradiť, odstrániť duplikáty, filtrovať alebo očistiť vybrané riadky"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Razvrsti, odstrani podvojene, filtriraj ali očisti izbrane vrstice"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortera, ta bort dubbletter, filtrera eller trimma de markerade raderna"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сортувати, вилучити повтори, відфільтрувати або очистити вибрані рядки"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对所选行进行排序、去重、过滤或清理"
          }
        }
      }
    },
