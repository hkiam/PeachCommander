        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem találtunk problémát — a struktúra, a tabulátorok, a többször szereplő kulcsok és az idézőjelek ellenőrizve (ez nem teljes elemzés)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
