    "Sends a keep-alive command to idle FTP connections. 0 disables it; a per-site value overrides this default.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odesílá příkaz keep-alive na nečinná připojení FTP. 0 jej zakáže; hodnota u jednotlivého serveru přepíše tuto výchozí hodnotu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender en keep-alive-kommando til inaktive FTP-forbindelser. 0 deaktiverer den; en værdi pr. sted tilsidesætter denne standard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet einen Keep-Alive-Befehl an inaktive FTP-Verbindungen. 0 deaktiviert es; ein Wert pro Site überschreibt diesen Standard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía un comando keep-alive a las conexiones FTP inactivas. 0 lo desactiva; un valor por sitio anula este valor por omisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie une commande de maintien de connexion aux connexions FTP inactives. 0 la désactive ; une valeur par site remplace cette valeur par défaut."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Életben tartó parancsot küld a tétlen FTP-kapcsolatoknak. A 0 letiltja; a helyenkénti érték felülírja ezt az alapértéket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia un comando keep-alive alle connessioni FTP inattive. 0 lo disabilita; un valore per sito ha la precedenza su questo predefinito."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유휴 FTP 연결에 연결 유지 명령을 보냅니다. 0은 비활성화하며, 사이트별 값이 이 기본값보다 우선합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender en keep-alive-kommando til inaktive FTP-tilkoblinger. 0 deaktiverer det; en verdi per nettsted overstyrer denne standarden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuurt een keep-alive-commando naar inactieve FTP-verbindingen. 0 schakelt het uit; een waarde per site overschrijft deze standaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysyła polecenie podtrzymania do bezczynnych połączeń FTP. 0 wyłącza je; wartość na witrynę zastępuje tę domyślną."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trimite o comandă keep-alive conexiunilor FTP inactive. 0 o dezactivează; o valoare per sit are prioritate față de această valoare implicită."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляет команду keep-alive для простаивающих FTP-подключений. 0 отключает её; значение для отдельного сервера переопределяет это значение по умолчанию."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odosiela príkaz na udržanie spojenia nečinným FTP pripojeniam. 0 ho vypína; hodnota pre konkrétny server prepíše toto predvolené nastavenie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošlje ukaz za ohranjanje povezave nedejavnim povezavam FTP. 0 ga onemogoči; vrednost za posamezno mesto ima prednost pred to privzeto vrednostjo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skickar ett keep-alive-kommando till inaktiva FTP-anslutningar. 0 inaktiverar det; ett värde per plats åsidosätter denna standard."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилає команду підтримки з’єднання для неактивних з’єднань FTP. 0 вимикає її; значення для окремого сайту перевизначає це типове."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向空闲的 FTP 连接发送保持连接命令。0 表示禁用；各站点的值会覆盖此默认值。"
          }
        }
      }
    },
