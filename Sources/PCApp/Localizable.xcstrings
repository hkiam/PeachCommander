    "Keep Only Lines Containing…": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponechat jen řádky obsahující…"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Behold kun linjer der indeholder…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Zeilen behalten, die enthalten…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservar solo las líneas que contengan…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne garder que les lignes contenant…"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak az ezt tartalmazó sorok megtartása…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni solo le righe che contengono…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음을 포함한 줄만 유지…"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Behold bare linjer som inneholder…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen regels behouden die bevatten…"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj tylko wiersze zawierające…"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Păstrează doar liniile care conțin…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставить только строки, содержащие…"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponechať len riadky obsahujúce…"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohrani samo vrstice, ki vsebujejo…"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behåll bara rader som innehåller…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишити лише рядки, що містять…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅保留包含以下内容的行…"
          }
        }
      }
    },
    "Keep a backup copy (.bak) of the previous contents when saving": {
      "localizations": {
        "cs": {
          "stringUnit": {
