    "Require a content-plugin field to satisfy a condition (e.g. image width > 1000).": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyžadovat, aby pole obsahového modulu splňovalo podmínku (např. šířka obrázku > 1000)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kræv, at et indholds-plugin-felt opfylder en betingelse (f.eks. billedbredde > 1000)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Content-Plugin-Feld muss eine Bedingung erfüllen (z. B. Bildbreite > 1000)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requerir que un campo de plugin de contenido cumpla una condición (p. ej. ancho de imagen > 1000)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exiger qu’un champ de module de contenu satisfasse une condition (par ex. largeur d’image > 1000)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy tartalombővítmény-mező feltételhez kötése (pl. képszélesség > 1000)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiedi che un campo del plugin di contenuto soddisfi una condizione (es. larghezza immagine > 1000)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조건을 충족하려면 콘텐츠 플러그인 필드가 필요합니다(예: 이미지 너비 > 1000)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Krev at et innholdsprogramtilleggsfelt oppfyller en betingelse (f.eks. bildebredde > 1000)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vereis dat een inhoud-plug-inveld aan een voorwaarde voldoet (bijv. afbeeldingsbreedte > 1000)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymagaj, aby pole wtyczki zawartości spełniało warunek (np. szerokość obrazu > 1000)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicită ca un câmp de plugin de conținut să satisfacă o condiție (de ex. lățimea imaginii > 1000)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требовать, чтобы поле контент-плагина удовлетворяло условию (например, ширина изображения > 1000)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyžadovať, aby pole obsahového zásuvného modulu spĺňalo podmienku (napr. šírka obrázka > 1000)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahtevaj, da polje vsebinskega vtičnika izpolnjuje pogoj (npr. širina slike > 1000)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kräv att ett fält från ett innehålls-plugin uppfyller ett villkor (t.ex. bildbredd > 1000)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимагати, щоб поле контент-плагіна відповідало умові (наприклад, ширина зображення > 1000)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要求内容插件字段满足某个条件（例如图像宽度 > 1000）。"
          }
        }
      }
    },
