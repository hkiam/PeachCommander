    "Remove them (shifting the rest), or overwrite them with a fill byte?": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odebrat je (s posunutím zbytku), nebo je přepsat výplňovým bajtem?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern dem (og forskyd resten), eller overskriv dem med en fyldbyte?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie entfernen (Rest verschiebt sich) oder mit einem Füllbyte überschreiben?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminarlos (desplazando el resto) o sobrescribirlos con un byte de relleno?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les supprimer (en décalant le reste) ou les remplacer par un octet de remplissage ?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eltávolítja őket (a többit eltolva), vagy felülírja őket kitöltőbájttal?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuoverli (spostando il resto) o sovrascriverli con un byte di riempimento?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제거하고(나머지를 이동) 또는 채움 바이트로 덮어쓰시겠습니까?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjerne dem (og forskyve resten), eller overskrive dem med en fyllbyte?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijderen (de rest opschuiven) of overschrijven met een vulbyte?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć je (przesuwając resztę) czy zastąpić je bajtem wypełnienia?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Îi eliminați (deplasând restul) sau îi suprascrieți cu un octet de umplere?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить их (сдвинув остальные) или перезаписать заполняющим байтом?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstrániť ich (s posunutím zvyšku) alebo ich prepísať výplňovým bajtom?"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ali jih odstranim (in premaknem preostanek) ali prepišem s polnilnim bajtom?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta bort dem (och förskjut resten), eller skriv över dem med ett fyllnadsbyte?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вилучити їх (зі зсувом решти) чи перезаписати їх байтом заповнення?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除它们（其余部分前移），还是用填充字节覆盖它们？"
          }
        }
      }
    },
