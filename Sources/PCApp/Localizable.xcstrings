    "No problem found — checked for structure, tabs, duplicate keys and quotes (not a full parse).": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenalezen žádný problém — zkontrolována struktura, tabulátory, duplicitní klíče a uvozovky (nejde o plné zpracování)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
