          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP: %lld Seite(n) hinzugefügt (Passwörter beim Verbinden neu eingeben)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP: %lld sitio(s) añadidos (vuelve a introducir las contraseñas al conectar)."
          }
        },
        "fr": {
