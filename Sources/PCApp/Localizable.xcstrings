    "Indented by %d, which lines up with no level open here (%@).": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odsazeno o %d, což neodpovídá žádné zde otevřené úrovni (%@)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indrykket med %d, hvilket ikke passer til noget niveau, der er åbent her (%@)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um %d eingerückt — das passt zu keiner hier offenen Ebene (%@)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Indented by %1$d, which lines up with no level open here (%2$@)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indentado %d, que no coincide con ningún nivel abierto aquí (%@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indenté de %d, ce qui ne correspond à aucun niveau ouvert ici (%@)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%d behúzás, amely egyetlen itt nyitott szinttel sem egyezik (%@)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indentato di %d, che non corrisponde a nessun livello aperto qui (%@)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "들여쓰기 %d은(는) 여기서 열려 있는 어떤 단계와도 맞지 않습니다(%@)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rykket inn med %d, som ikke passer med noe nivå som er åpent her (%@)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geïndenteerd met %d, wat bij geen enkel hier open niveau past (%@)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wcięcie %d nie odpowiada żadnemu otwartemu tutaj poziomowi (%@)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Indentat cu %d, ceea ce nu corespunde niciunui nivel deschis aici (%@)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отступ %d не совпадает ни с одним открытым здесь уровнем (%@)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odsadené o %d, čo nezodpovedá žiadnej tu otvorenej úrovni (%@)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamaknjeno za %d, kar se ne ujema z nobeno tu odprto ravnjo (%@)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Indenterad med %d, vilket inte stämmer med någon nivå som är öppen här (%@)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відступ %d не збігається з жодним відкритим тут рівнем (%@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缩进 %d 与此处任何已打开的层级都不匹配（%@）。"
          }
        }
      }
    },
    "Indented deeper than the line above, which already has a value.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odsazeno hlouběji než řádek nad ním, který už má hodnotu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indrykket dybere end linjen ovenover, som allerede har en værdi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiefer eingerückt als die Zeile darüber, die bereits einen Wert hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indentado más que la línea anterior, que ya tiene un valor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indenté plus profondément que la ligne au-dessus, qui a déjà une valeur."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mélyebben behúzva, mint a fölötte lévő sor, amelynek már van értéke."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indentato più della riga sopra, che ha già un valore."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 값이 있는 윗줄보다 더 깊게 들여썼습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rykket dypere inn enn linjen over, som allerede har en verdi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieper geïndenteerd dan de regel erboven, die al een waarde heeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wcięty głębiej niż wiersz powyżej, który już ma wartość."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Indentat mai adânc decât linia de deasupra, care are deja o valoare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отступ больше, чем у строки выше, у которой уже есть значение."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odsadené hlbšie ako riadok nad ním, ktorý už má hodnotu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamaknjeno globlje kot vrstica nad njo, ki že ima vrednost."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Indenterad djupare än raden ovanför, som redan har ett värde."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відступ більший, ніж у рядка вище, який уже має значення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比上一行缩进更深，而上一行已经有值。"
          }
        }
      }
    },
