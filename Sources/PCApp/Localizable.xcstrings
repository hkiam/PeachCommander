    "Explicit FTPS (AUTH TLS) is not supported yet. Use implicit FTPS or plain FTP.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Explicitní FTPS (AUTH TLS) zatím není podporováno. Použijte implicitní FTPS nebo prosté FTP."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksplicit FTPS (AUTH TLS) understøttes endnu ikke. Brug implicit FTPS eller almindelig FTP."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Explizites FTPS (AUTH TLS) wird noch nicht unterstützt. Verwende implizites FTPS oder einfaches FTP."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FTPS explícito (AUTH TLS) aún no es compatible. Usa FTPS implícito o FTP simple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le FTPS explicite (AUTH TLS) n’est pas encore pris en charge. Utilisez le FTPS implicite ou le FTP simple."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az explicit FTPS (AUTH TLS) még nem támogatott. Használjon implicit FTPS-t vagy sima FTP-t."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "FTPS esplicito (AUTH TLS) non è ancora supportato. Usa FTPS implicito o FTP semplice."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명시적 FTPS(AUTH TLS)는 아직 지원되지 않습니다. 암시적 FTPS 또는 일반 FTP를 사용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksplisitt FTPS (AUTH TLS) støttes ikke ennå. Bruk implisitt FTPS eller vanlig FTP."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Expliciet FTPS (AUTH TLS) wordt nog niet ondersteund. Gebruik impliciet FTPS of gewoon FTP."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawny FTPS (AUTH TLS) nie jest jeszcze obsługiwany. Użyj niejawnego FTPS albo zwykłego FTP."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "FTPS explicit (AUTH TLS) nu este încă acceptat. Folosiți FTPS implicit sau FTP simplu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Явный FTPS (AUTH TLS) пока не поддерживается. Используйте неявный FTPS или обычный FTP."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Explicitné FTPS (AUTH TLS) zatiaľ nie je podporované. Použite implicitné FTPS alebo obyčajné FTP."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksplicitni FTPS (AUTH TLS) še ni podprt. Uporabite implicitni FTPS ali navadni FTP."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Explicit FTPS (AUTH TLS) stöds inte än. Använd implicit FTPS eller vanlig FTP."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Явний FTPS (AUTH TLS) ще не підтримується. Використайте неявний FTPS або звичайний FTP."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显式 FTPS（AUTH TLS）尚不支持。请使用隐式 FTPS 或普通 FTP。"
          }
        }
      }
    },
    "Explicit FTPS (AUTH TLS) is not supported yet. Use implicit FTPS or plain ftp://.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Explicitní FTPS (AUTH TLS) zatím není podporováno. Použijte implicitní FTPS nebo prosté ftp://."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksplicit FTPS (AUTH TLS) understøttes ikke endnu. Brug implicit FTPS eller almindelig ftp://."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Explizites FTPS (AUTH TLS) wird noch nicht unterstützt. Verwende implizites FTPS oder einfaches ftp://."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El FTPS explícito (AUTH TLS) aún no es compatible. Usa FTPS implícito o ftp:// simple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le FTPS explicite (AUTH TLS) n’est pas encore pris en charge. Utilisez le FTPS implicite ou le ftp:// simple."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az explicit FTPS (AUTH TLS) még nem támogatott. Használjon implicit FTPS-t vagy egyszerű ftp:// protokollt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "FTPS esplicito (AUTH TLS) non è ancora supportato. Usa FTPS implicito o ftp:// semplice."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명시적 FTPS(AUTH TLS)는 아직 지원되지 않습니다. 암시적 FTPS 또는 일반 ftp://를 사용하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksplisitt FTPS (AUTH TLS) støttes ikke ennå. Bruk implisitt FTPS eller vanlig ftp://."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Expliciete FTPS (AUTH TLS) wordt nog niet ondersteund. Gebruik impliciete FTPS of gewone ftp://."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawny FTPS (AUTH TLS) nie jest jeszcze obsługiwany. Użyj niejawnego FTPS lub zwykłego ftp://."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "FTPS explicit (AUTH TLS) nu este acceptat încă. Folosiți FTPS implicit sau ftp:// simplu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Явный FTPS (AUTH TLS) пока не поддерживается. Используйте неявный FTPS или обычный ftp://."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Explicitné FTPS (AUTH TLS) zatiaľ nie je podporované. Použite implicitné FTPS alebo obyčajné ftp://."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izrecni FTPS (AUTH TLS) še ni podprt. Uporabite implicitni FTPS ali navadni ftp://."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Explicit FTPS (AUTH TLS) stöds inte ännu. Använd implicit FTPS eller vanlig ftp://."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Явний FTPS (AUTH TLS) поки що не підтримується. Використовуйте неявний FTPS або звичайний ftp://."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
