    "Files can only be deleted inside .zip archives. Files can still be added to this one.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubory lze mazat pouze v archivech .zip. Přidávat sem lze i nadále."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filer kan kun slettes i .zip-arkiver. Her kan der stadig tilføjes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien lassen sich nur in .zip-Archiven löschen. Hinzufügen ist hier weiterhin möglich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se pueden eliminar archivos dentro de archivos .zip. Aquí sí se pueden añadir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers ne peuvent être supprimés que dans les archives .zip. L’ajout reste possible ici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fájlokat csak .zip archívumokban lehet törölni. Hozzáadni itt továbbra is lehet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file possono essere eliminati solo negli archivi .zip. Qui è comunque possibile aggiungerli."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일은 .zip 아카이브에서만 삭제할 수 있습니다. 추가는 계속 가능합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filer kan bare slettes i .zip-arkiver. Her kan de fortsatt legges til."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestanden kunnen alleen in .zip-archieven worden verwijderd. Toevoegen kan hier wel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki można usuwać tylko w archiwach .zip. Dodawanie tutaj nadal działa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierele pot fi șterse doar în arhive .zip. Adăugarea aici este în continuare posibilă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалять файлы можно только в архивах .zip. Добавлять сюда по-прежнему можно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Súbory možno mazať iba v archívoch .zip. Pridávať sem možno naďalej."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteke je mogoče izbrisati samo v arhivih .zip. Dodajanje je tu še vedno mogoče."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filer kan bara raderas i .zip-arkiv. Här går det fortfarande att lägga till."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вилучати файли можна лише в архівах .zip. Додавати сюди все ще можна."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能在 .zip 归档中删除文件。此处仍可添加。"
          }
        }
      }
    },
    "Files can only be renamed inside .zip archives.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubory lze přejmenovat pouze v archivech .zip."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filer kan kun omdøbes i .zip-arkiver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien lassen sich nur in .zip-Archiven umbenennen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se pueden renombrar archivos dentro de archivos .zip."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers ne peuvent être renommés que dans les archives .zip."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fájlokat csak .zip archívumokban lehet átnevezni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file possono essere rinominati solo negli archivi .zip."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일은 .zip 아카이브에서만 이름을 바꿀 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filer kan bare få nytt navn i .zip-arkiver."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestanden kunnen alleen in .zip-archieven worden hernoemd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki można zmieniać nazwę tylko w archiwach .zip."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierele pot fi redenumite doar în arhive .zip."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переименовывать файлы можно только в архивах .zip."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Súbory možno premenovať iba v archívoch .zip."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteke je mogoče preimenovati samo v arhivih .zip."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filer kan bara byta namn i .zip-arkiv."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейменовувати файли можна лише в архівах .zip."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
