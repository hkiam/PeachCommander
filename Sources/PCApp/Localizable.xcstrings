    "SF Symbol (sf:name), an image file path, or a bundled icon name. Use the picker to browse.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "SF Symbol (sf:název), cesta k souboru obrázku nebo název přibalené ikony. K procházení použijte výběr."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "SF-symbol (sf:navn), en sti til en billedfil eller et medfølgende symbolnavn. Brug vælgeren til at gennemse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SF-Symbol (sf:name), ein Bilddateipfad oder ein mitgelieferter Symbolname. Zum Durchsuchen die Auswahl verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Símbolo SF (sf:nombre), la ruta de un archivo de imagen o el nombre de un icono incluido. Usa el selector para explorar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbole SF (sf:nom), un chemin de fichier image ou un nom d’icône intégrée. Utilisez le sélecteur pour parcourir."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "SF Symbol (sf:név), képfájl útvonala vagy beépített ikonnév. A böngészéshez használja a választót."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "SF Symbol (sf:nome), un percorso di file immagine o un nome di icona inclusa. Usa il selettore per sfogliare."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SF 기호(sf:이름), 이미지 파일 경로 또는 번들 아이콘 이름. 선택기를 사용하여 찾아보십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "SF Symbol (sf:navn), en bildefilsti, eller et medfølgende ikonnavn. Bruk velgeren for å bla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "SF Symbol (sf:naam), een pad naar een afbeeldingsbestand of een meegeleverde symboolnaam. Gebruik de kiezer om te bladeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbol SF (sf:nazwa), ścieżka pliku obrazu lub nazwa dołączonej ikony. Użyj selektora, aby przeglądać."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Simbol SF (sf:nume), o cale de fișier imagine sau numele unei pictograme incluse. Folosiți selectorul pentru a răsfoi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "SF-символ (sf:name), путь к файлу изображения или имя встроенного значка. Используйте выбор для обзора."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "SF Symbol (sf:názov), cesta k súboru obrázka alebo názov priloženej ikony. Na prehliadanie použite výber."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Simbol SF (sf:ime), pot do slikovne datoteke ali ime priložene ikone. Uporabite izbirnik za brskanje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "SF Symbol (sf:namn), en sökväg till en bildfil eller ett namn på en medföljande symbol. Använd väljaren för att bläddra."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "SF Symbol (sf:name), шлях до файлу зображення або ім’я вбудованої піктограми. Для перегляду скористайтеся засобом вибору."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SF Symbol（sf:名称）、图像文件路径或捆绑的图标名称。使用选取器进行浏览。"
          }
        }
      }
    },
