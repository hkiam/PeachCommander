    "Copying straight from one server to another is not supported. Download the files first, then upload them.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopírování přímo z jednoho serveru na druhý není podporováno. Nejprve soubory stáhněte a potom nahrajte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At kopiere direkte fra én server til en anden understøttes ikke. Hent filerne først, og upload dem derefter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkt von einem Server zu einem anderen zu kopieren wird nicht unterstützt. Laden Sie die Dateien zuerst herunter und dann hoch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiar directamente de un servidor a otro no se admite. Descargue primero los archivos y luego súbalos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copier directement d’un serveur à un autre n’est pas pris en charge. Téléchargez d’abord les fichiers, puis envoyez-les."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egyik kiszolgálóról a másikra való közvetlen másolás nem támogatott. Töltse le először a fájlokat, majd töltse fel őket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiare direttamente da un server a un altro non è supportato. Scaricate prima i file, poi caricateli."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 서버에서 다른 서버로 바로 복사하는 것은 지원하지 않습니다. 먼저 파일을 내려받은 뒤 올리십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å kopiere direkte fra én tjener til en annen støttes ikke. Last ned filene først, og last dem så opp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechtstreeks van de ene server naar de andere kopiëren wordt niet ondersteund. Download de bestanden eerst en upload ze daarna."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiowanie wprost z jednego serwera na drugi nie jest obsługiwane. Najpierw pobierz pliki, a potem je wyślij."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Copierea direct de la un server la altul nu este acceptată. Descărcați mai întâi fișierele, apoi încărcați-le."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копирование напрямую с одного сервера на другой не поддерживается. Сначала загрузите файлы, затем отправьте их."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopírovanie priamo z jedného servera na druhý nie je podporované. Najprv súbory stiahnite a potom nahrajte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiranje neposredno z enega strežnika na drugega ni podprto. Datoteke najprej prenesite, nato jih naložite."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att kopiera direkt från en server till en annan stöds inte. Hämta filerna först och ladda sedan upp dem."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копіювання напряму з одного сервера на інший не підтримується. Спершу завантажте файли, потім надішліть їх."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持直接从一台服务器复制到另一台。请先下载文件，然后再上传。"
          }
        }
      }
    },
