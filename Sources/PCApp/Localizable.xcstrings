    "Enter a user name, or tick Anonymous.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte uživatelské jméno nebo zaškrtněte Anonymní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast et brugernavn, eller sæt flueben i Anonym."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen Benutzernamen ein oder aktiviere „Anonym“."
          }
        },
        "es": {
