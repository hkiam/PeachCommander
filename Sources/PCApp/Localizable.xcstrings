    "Enter a TCP/UDP port number to locate the process using it.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte číslo portu TCP/UDP pro nalezení procesu, který jej používá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast et TCP/UDP-portnummer for at finde den proces, der bruger det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Portnummer (TCP/UDP) eingeben, um den belegenden Prozess zu finden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un número de puerto TCP/UDP para localizar el proceso que lo usa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un numéro de port TCP/UDP pour localiser le processus qui l’utilise."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjon meg egy TCP/UDP-portszámot az azt használó folyamat megkereséséhez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un numero di porta TCP/UDP per individuare il processo che la usa."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 중인 프로세스를 찾을 TCP/UDP 포트 번호를 입력하십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn et TCP/UDP-portnummer for å finne prosessen som bruker den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer een TCP/UDP-poortnummer in om het proces te vinden dat het gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadź numer portu TCP/UDP, aby zlokalizować używający go proces."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduceți un număr de port TCP/UDP pentru a localiza procesul care îl folosește."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите номер порта TCP/UDP, чтобы найти использующий его процесс."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadajte číslo TCP/UDP portu na nájdenie procesu, ktorý ho používa."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vnesite številko vrat TCP/UDP, da poiščete proces, ki jih uporablja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange ett TCP/UDP-portnummer för att hitta processen som använder den."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть номер порту TCP/UDP, щоб знайти процес, який його використовує."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入 TCP/UDP 端口号以查找使用它的进程。"
          }
        }
      }
    },
    "Enter a file path. Processes holding it open are highlighted: reading, writing, and both in their own colour.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte cestu k souboru. Procesy, které jej mají otevřený, se zvýrazní: čtoucí, zapisující a obojí vlastní barvou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast en filsti. Processer, der har den åben, fremhæves: læsende, skrivende og begge i hver sin farve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateipfad eingeben. Prozesse, die sie geöffnet haben, werden hervorgehoben: lesend, schreibend und beides in eigener Farbe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce la ruta de un archivo. Los procesos que lo tienen abierto se resaltan: lectura, escritura y ambos con su propio color."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un chemin de fichier. Les processus qui l’ont ouvert sont mis en évidence : lecture, écriture et les deux, chacun dans sa couleur."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjon meg egy fájlútvonalat. A fájlt nyitva tartó folyamatok kiemelve jelennek meg: olvasó, író és mindkettő saját színnel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il percorso di un file. I processi che lo tengono aperto vengono evidenziati: in lettura, in scrittura ed entrambi con un colore proprio."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 경로를 입력하십시오. 해당 파일을 열고 있는 프로세스가 강조 표시됩니다: 읽기, 쓰기, 둘 다 각각 다른 색상입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn en filbane. Prosesser som har den åpen, blir uthevet: lesende, skrivende og begge i hver sin farge."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer een bestandspad in. Processen die het geopend hebben worden gemarkeerd: lezend, schrijvend en beide in een eigen kleur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadź ścieżkę pliku. Procesy, które mają go otwarty, zostaną wyróżnione: odczyt, zapis i oba własnym kolorem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduceți calea unui fișier. Procesele care îl țin deschis sunt evidențiate: citire, scriere și ambele, fiecare cu culoarea sa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите путь к файлу. Процессы, удерживающие его открытым, будут выделены: чтение, запись и оба — своим цветом."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadajte cestu k súboru. Procesy, ktoré ho majú otvorený, sa zvýraznia: čítajúce, zapisujúce a obidve vlastnou farbou."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vnesite pot do datoteke. Procesi, ki jo imajo odprto, bodo označeni: branje, pisanje in oboje, vsak s svojo barvo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange en filsökväg. Processer som har den öppen markeras: läsande, skrivande och båda i var sin färg."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть шлях до файлу. Процеси, які тримають його відкритим, буде підсвічено: читання, запис і обидва — власним кольором."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入文件路径。占用该文件的进程将以不同颜色高亮显示：读取、写入以及两者。"
          }
        }
      }
    },
    "Enter a host name.": {
