    "The text changed while the command was running.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Text se během běhu příkazu změnil."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksten blev ændret, mens kommandoen kørte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Text hat sich während der Ausführung geändert."
          }
