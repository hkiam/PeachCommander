    "There is no key file at %@. Leave it blank to use the ssh-agent or a key in ~/.ssh.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na %@ není žádný soubor s klíčem. Ponechte prázdné pro ssh-agent nebo klíč v ~/.ssh."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ingen nøglefil på %@. Lad feltet være tomt for at bruge ssh-agent eller en nøgle i ~/.ssh."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter %@ liegt keine Schlüsseldatei. Lass das Feld leer, um den ssh-agent oder einen Schlüssel in ~/.ssh zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún archivo de clave en %@. Déjalo en blanco para usar el ssh-agent o una clave en ~/.ssh."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a pas de fichier de clé à %@. Laissez le champ vide pour utiliser le ssh-agent ou une clé dans ~/.ssh."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ helyen nincs kulcsfájl. Hagyja üresen az ssh-agent vagy egy ~/.ssh-beli kulcs használatához."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c’è nessun file di chiave in %@. Lascialo vuoto per usare l’ssh-agent o una chiave in ~/.ssh."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 키 파일이 없습니다. 비워 두면 ssh-agent나 ~/.ssh의 키를 사용합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finnes ingen nøkkelfil på %@. La feltet stå tomt for å bruke ssh-agent eller en nøkkel i ~/.ssh."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er staat geen sleutelbestand op %@. Laat het leeg om de ssh-agent of een sleutel in ~/.ssh te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pod %@ nie ma pliku klucza. Zostaw puste, aby użyć ssh-agenta lub klucza w ~/.ssh."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu există niciun fișier de cheie la %@. Lăsați gol pentru a folosi ssh-agent sau o cheie din ~/.ssh."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По пути %@ нет файла ключа. Оставьте поле пустым, чтобы использовать ssh-agent или ключ в ~/.ssh."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na %@ nie je žiadny súbor s kľúčom. Nechajte prázdne pre ssh-agent alebo kľúč v ~/.ssh."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na %@ ni datoteke ključa. Pustite prazno za ssh-agent ali ključ v ~/.ssh."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns ingen nyckelfil på %@. Lämna fältet tomt för att använda ssh-agent eller en nyckel i ~/.ssh."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За шляхом %@ немає файла ключа. Залиште поле порожнім, щоб використати ssh-agent або ключ у ~/.ssh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 处没有密钥文件。留空则使用 ssh-agent 或 ~/.ssh 中的密钥。"
          }
        }
      }
    },
    "This cannot be undone.": {
      "localizations": {
        "cs": {
          "stringUnit": {
