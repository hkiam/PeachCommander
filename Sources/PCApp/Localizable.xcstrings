          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az asszisztens futtathat shell-parancsokat (mindig rákérdez)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti all'assistente di eseguire comandi shell (chiede ogni volta)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어시스턴트가 셸 명령을 실행하도록 허용(매번 확인)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "La assistenten kjøre skallkommandoer (spør hver gang)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat de assistent shell-opdrachten uitvoeren (vraagt elke keer)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwól asystentowi uruchamiać polecenia powłoki (pyta za każdym razem)"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite asistentului să ruleze comenzi shell (întreabă de fiecare dată)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить ассистенту выполнять команды оболочки (спрашивает каждый раз)"
