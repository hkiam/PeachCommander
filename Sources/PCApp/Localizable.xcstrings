    "Load a saved search, or save the current settings as a reusable template.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Načíst uložené hledání nebo uložit aktuální nastavení jako opakovaně použitelnou šablonu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indlæs en gemt søgning, eller gem de aktuelle indstillinger som en genanvendelig skabelon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine gespeicherte Suche laden oder die aktuellen Einstellungen als wiederverwendbare Vorlage speichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga una búsqueda guardada o guarda los ajustes actuales como una plantilla reutilizable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charger une recherche enregistrée ou enregistrer les réglages actuels comme modèle réutilisable."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentett keresés betöltése, vagy a jelenlegi beállítások mentése újrafelhasználható sablonként."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carica una ricerca salvata o salva le impostazioni correnti come modello riutilizzabile."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 검색을 불러오거나 현재 설정을 재사용 가능한 템플릿으로 저장합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Last inn et lagret søk, eller lagre gjeldende innstillinger som en gjenbrukbar mal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laad een bewaarde zoekopdracht, of bewaar de huidige instellingen als herbruikbaar sjabloon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wczytaj zapisane wyszukiwanie lub zapisz bieżące ustawienia jako szablon wielokrotnego użytku."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încarcă o căutare salvată sau salvează configurările curente ca șablon reutilizabil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузите сохранённый поиск или сохраните текущие настройки как многоразовый шаблон."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Načítajte uložené vyhľadávanie alebo uložte aktuálne nastavenia ako opakovane použiteľnú šablónu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naložite shranjeno iskanje ali shranite trenutne nastavitve kot ponovno uporabno predlogo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läs in en sparad sökning, eller spara de aktuella inställningarna som en återanvändbar mall."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажте збережений пошук або збережіть поточні параметри як багаторазовий шаблон."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载已存储的搜索，或将当前设置存储为可重复使用的模板。"
          }
        }
      }
    },
