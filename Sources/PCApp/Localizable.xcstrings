    "Query the Spotlight index instead of scanning. Local folders only; ignores regex, depth and selection scope.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotázat se indexu Spotlight namísto skenování. Pouze místní složky; ignoruje regulární výrazy, hloubku a rozsah výběru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forespørg Spotlight-indekset i stedet for at scanne. Kun lokale mapper; ignorerer regex, dybde og markeringsomfang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Spotlight-Index abfragen statt zu durchsuchen. Nur lokale Ordner; ignoriert Regex, Tiefe und Auswahlbereich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultar el índice de Spotlight en lugar de analizar. Solo carpetas locales; ignora regex, profundidad y ámbito de selección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Interroger l’index Spotlight au lieu d’analyser. Dossiers locaux uniquement ; ignore les regex, la profondeur et la portée de sélection."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Spotlight-index lekérdezése vizsgálat helyett. Csak helyi mappák; figyelmen kívül hagyja a reguláris kifejezést, a mélységet és a kijelölési hatókört."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interroga l’indice Spotlight invece di eseguire la scansione. Solo cartelle locali; ignora regex, profondità e ambito di selezione."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔 대신 Spotlight 색인을 조회합니다. 로컬 폴더 전용이며, 정규식, 깊이 및 선택 범위를 무시합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spør Spotlight-indeksen i stedet for å skanne. Kun lokale mapper; ignorerer regex, dybde og utvalgsomfang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Spotlight-index doorzoeken in plaats van te scannen. Alleen lokale mappen; negeert regex, diepte en selectiebereik."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpytaj indeks Spotlight zamiast skanowania. Tylko lokalne foldery; ignoruje wyrażenia regularne, głębokość i zakres zaznaczenia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Interoghează indexul Spotlight în loc să scaneze. Doar dosare locale; ignoră regex, adâncimea și domeniul selecției."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрашивать индекс Spotlight вместо сканирования. Только локальные папки; игнорирует regex, глубину и область выделения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotazovať index Spotlight namiesto skenovania. Len lokálne priečinky; ignoruje regex, hĺbku a rozsah výberu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Namesto pregledovanja poizveduj po indeksu Spotlight. Samo lokalne mape; prezre regularne izraze, globino in obseg izbire."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fråga Spotlight-indexet i stället för att skanna. Endast lokala mappar; ignorerar regex, djup och markeringsomfång."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитувати індекс Spotlight замість сканування. Лише локальні теки; ігнорує regex, глибину та область вибору."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查询 Spotlight 索引而非扫描。仅限本地文件夹；忽略正则表达式、深度和选择范围。"
          }
        }
      }
    },
    "Queue for later": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zařadit do fronty na později"
          }
        },
        "da": {
