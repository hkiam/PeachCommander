          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan ikke representere denne verdien"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan deze waarde niet weergeven"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie może przedstawić tej wartości"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nu poate reprezenta această valoare"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не может представить это значение"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nedokáže túto hodnotu vyjadriť"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ te vrednosti ne more predstaviti"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan inte representera detta värde"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не може представити це значення"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 无法表示此值"
          }
        }
