    "Open Peach Commander first, then run this action.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejprve otevřete Peach Commander a potom spusťte tuto akci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn først Peach Commander, og kør derefter denne handling."
