    "Open the folder holding your own theme files. An example is created the first time.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevře složku s vašimi vlastními soubory motivů. Při prvním otevření se vytvoří ukázka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbner mappen med dine egne temafiler. Første gang oprettes et eksempel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet den Ordner mit Ihren eigenen Themen-Dateien. Beim ersten Mal wird ein Beispiel angelegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la carpeta con sus propios archivos de tema. La primera vez se crea un ejemplo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre le dossier contenant vos propres fichiers de thème. Un exemple est créé la première fois."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megnyitja a saját témafájljait tartalmazó mappát. Első alkalommal létrejön egy minta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre la cartella con i vostri file di tema. La prima volta viene creato un esempio."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 테마 파일이 들어 있는 폴더를 엽니다. 처음 열 때 예제가 만들어집니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpner mappen med dine egne temafiler. Første gang opprettes et eksempel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent de map met uw eigen themabestanden. De eerste keer wordt een voorbeeld aangemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera folder z własnymi plikami motywów. Za pierwszym razem tworzony jest przykład."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide dosarul cu propriile fișiere de temă. La prima deschidere se creează un exemplu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает папку с вашими файлами тем. При первом открытии создаётся пример."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorí priečinok s vašimi súbormi motívov. Pri prvom otvorení sa vytvorí ukážka."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpre mapo z vašimi datotekami tem. Ob prvem odprtju se ustvari primer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppnar mappen med dina egna temafiler. Första gången skapas ett exempel."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває теку з вашими файлами тем. Першого разу створюється приклад."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开存放你自己主题文件的文件夹。首次打开时会创建一个示例。"
          }
        }
      }
    },
