          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du flettede ændringer, der ikke er gemt. Luk alligevel?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt zusammengeführte, nicht gespeicherte Änderungen. Trotzdem schließen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has combinado cambios que no están guardados. ¿Cerrar de todos modos?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez fusionné des modifications non enregistrées. Fermer quand même ?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem mentett módosításokat egyesített. Mindenképp bezárja?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai unito modifiche non salvate. Chiudere comunque?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장되지 않은 변경 사항을 병합했습니다. 그래도 닫으시겠습니까?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du slo sammen endringer som ikke er lagret. Lukke likevel?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt wijzigingen samengevoegd die niet zijn bewaard. Toch sluiten?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scalone zmiany nie zostały zapisane. Zamknąć mimo to?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ați îmbinat modificări care nu sunt salvate. Închideți oricum?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы объединили изменения, которые не сохранены. Всё равно закрыть?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zlúčili ste zmeny, ktoré nie sú uložené. Napriek tomu zavrieť?"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Združili ste spremembe, ki niso shranjene. Vseeno zaprem?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du sammanfogade ändringar som inte är sparade. Stäng ändå?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви злили зміни, які не збережено. Усе одно закрити?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你合并了尚未存储的更改。仍要关闭吗？"
          }
        }
      }
    },
