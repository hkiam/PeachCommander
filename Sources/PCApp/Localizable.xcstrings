    "Headers, one per line — e.g. “Referer: …” or “Cookie: …”": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlavičky, jedna na řádek — např. „Referer: …“ nebo „Cookie: …“"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Headere, én pr. linje — f.eks. “Referer: …” eller “Cookie: …”"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Header, einer pro Zeile — z. B. „Referer: …“ oder „Cookie: …“"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cabeceras, una por línea — p. ej. “Referer: …” o “Cookie: …”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En-têtes, un par ligne — par ex. « Referer : … » ou « Cookie : … »"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fejlécek, soronként egy — pl. „Referer: …” vagy „Cookie: …”"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Intestazioni, una per riga — es. “Referer: …” o “Cookie: …”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "헤더, 한 줄에 하나씩 — 예: “Referer: …” 또는 “Cookie: …”"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoder, ett per linje — f.eks. «Referer: …» eller «Cookie: …»"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Headers, één per regel — bijv. “Referer: …” of “Cookie: …”"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagłówki, po jednym w wierszu — np. „Referer: …” lub „Cookie: …”"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteturi, câte unul pe linie — de ex. „Referer: …” sau „Cookie: …”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заголовки, по одному в строке — например, «Referer: …» или «Cookie: …»"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlavičky, jedna na riadok — napr. „Referer: …“ alebo „Cookie: …“"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Glave, ena na vrstico — npr. „Referer: …“ ali „Cookie: …“"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Huvuden, ett per rad — t.ex. ”Referer: …” eller ”Cookie: …”"
          }
        },
        "uk": {
          "stringUnit": {
