    "Only a SOCKS5 proxy can carry FTP; %@ is not supported here.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP může přenášet pouze proxy SOCKS5; %@ zde není podporováno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun en SOCKS5-proxy kan bære FTP; %@ understøttes ikke her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ein SOCKS5-Proxy kann FTP übertragen; %@ wird hier nicht unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un proxy SOCKS5 puede transportar FTP; %@ no es compatible aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul un proxy SOCKS5 peut transporter le FTP ; %@ n’est pas pris en charge ici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az FTP-t csak SOCKS5 proxy tudja továbbítani; a(z) %@ itt nem támogatott."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un proxy SOCKS5 può trasportare FTP; %@ non è supportato qui."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP는 SOCKS5 프록시만 전달할 수 있습니다. %@은(는) 여기서 지원되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare en SOCKS5-proxy kan bære FTP; %@ støttes ikke her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen een SOCKS5-proxy kan FTP dragen; %@ wordt hier niet ondersteund."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP może przenosić tylko proxy SOCKS5; %@ nie jest tutaj obsługiwane."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar un proxy SOCKS5 poate transporta FTP; %@ nu este acceptat aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP может передавать только прокси SOCKS5; %@ здесь не поддерживается."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP môže prenašať iba proxy SOCKS5; %@ tu nie je podporovaný."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP lahko prenaša le posrednik SOCKS5; %@ tukaj ni podprt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast en SOCKS5-proxy kan bära FTP; %@ stöds inte här."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP може передавати лише проксі SOCKS5; %@ тут не підтримується."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有 SOCKS5 代理能承载 FTP；此处不支持 %@。"
          }
        }
      }
    },
