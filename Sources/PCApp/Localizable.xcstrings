    "Discard changes and reload from disk?": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahodit změny a znovu načíst z disku?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kassér ændringer og genindlæs fra disk?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen verwerfen und von der Festplatte neu laden?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Descartar los cambios y volver a cargar desde el disco?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorer les modifications et recharger depuis le disque ?"
