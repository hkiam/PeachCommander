    "Limit the search to the items currently selected in the active panel": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Omezit hledání na položky aktuálně vybrané v aktivním panelu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Begræns søgningen til de emner, der aktuelt er valgt i det aktive panel"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Suche auf die aktuell im aktiven Panel ausgewählten Objekte beschränken"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitar la búsqueda a los elementos seleccionados actualmente en el panel activo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limiter la recherche aux éléments actuellement sélectionnés dans le panneau actif"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A keresés korlátozása az aktív panelen jelenleg kijelölt elemekre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita la ricerca agli elementi attualmente selezionati nel pannello attivo"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색을 활성 패널에서 현재 선택된 항목으로 제한"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrens søket til objektene som er valgt i det aktive panelet"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het zoeken beperken tot de objecten die momenteel geselecteerd zijn in het actieve paneel"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogranicz wyszukiwanie do elementów aktualnie zaznaczonych w aktywnym panelu"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitează căutarea la elementele selectate curent în panoul activ"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ограничить поиск объектами, выбранными в активной панели"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obmedziť vyhľadávanie na položky aktuálne vybrané v aktívnom paneli"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omeji iskanje na predmete, trenutno izbrane v aktivnem panelu"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Begränsa sökningen till objekten som är markerade i den aktiva panelen"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обмежити пошук об’єктами, вибраними наразі в активній панелі"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将搜索限定于活动面板中当前所选的项目"
          }
        }
      }
    },
    "Limit this transfer's speed. Takes effect immediately and leaves the other transfers alone.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Omezí rychlost tohoto přenosu. Projeví se okamžitě a ostatních přenosů se nedotkne."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrænser hastigheden for denne overførsel. Træder i kraft med det samme og rører ikke de andre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrenzt das Tempo dieser Übertragung. Wirkt sofort und lässt die anderen Übertragungen unberührt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita la velocidad de esta transferencia. Surte efecto de inmediato y no afecta a las demás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite la vitesse de ce transfert. Prend effet immédiatement et n’affecte pas les autres transferts."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Korlátozza ennek az átvitelnek a sebességét. Azonnal érvénybe lép, a többit nem érinti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita la velocità di questo trasferimento. Ha effetto subito e lascia invariati gli altri."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 전송의 속도를 제한합니다. 즉시 적용되며 다른 전송에는 영향을 주지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrenser hastigheten på denne overføringen. Trer i kraft umiddelbart og lar de andre være."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beperkt de snelheid van deze overdracht. Werkt meteen en laat de andere overdrachten met rust."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogranicza prędkość tego transferu. Działa natychmiast i nie wpływa na pozostałe."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitează viteza acestui transfer. Are efect imediat și nu afectează celelalte transferuri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ограничивает скорость этой передачи. Действует сразу и не затрагивает остальные."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obmedzí rýchlosť tohto prenosu. Prejaví sa okamžite a ostatných prenosov sa nedotkne."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omeji hitrost tega prenosa. Učinkuje takoj in drugih prenosov ne spremeni."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Begränsar hastigheten för den här överföringen. Träder i kraft direkt och lämnar de andra ifred."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обмежує швидкість цієї передачі. Діє одразу й не зачіпає інші."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "限制此传输的速度。立即生效，且不影响其他传输。"
          }
        }
      }
    },
    "Limits copy/move and network transfer speed. 0 = unlimited.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Omezuje rychlost kopírování/přesunu a síťového přenosu. 0 = neomezeně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrænser hastighed for kopiering/flytning og netværksoverførsel. 0 = ubegrænset."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrenzt Kopier-/Verschiebe- und Netzwerk-Übertragungsrate. 0 = unbegrenzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita la velocidad de copia/movimiento y de transferencia en red. 0 = sin límite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite la vitesse de copie/déplacement et de transfert réseau. 0 = illimité."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Korlátozza a másolás/áthelyezés és a hálózati átvitel sebességét. 0 = korlátlan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita la velocità di copia/spostamento e di trasferimento in rete. 0 = illimitata."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사/이동 및 네트워크 전송 속도를 제한합니다. 0 = 무제한."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrenser hastighet for kopiering/flytting og nettverksoverføring. 0 = ubegrenset."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beperkt de snelheid van kopiëren/verplaatsen en netwerkoverdracht. 0 = onbeperkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogranicza prędkość kopiowania/przenoszenia i transferu sieciowego. 0 = bez ograniczeń."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitează viteza de copiere/mutare și de transfer în rețea. 0 = nelimitat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ограничивает скорость копирования/перемещения и сетевой передачи. 0 = без ограничений."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obmedzuje rýchlosť kopírovania/presunu a sieťového prenosu. 0 = neobmedzene."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omeji hitrost kopiranja/premikanja in omrežnega prenosa. 0 = neomejeno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Begränsar hastigheten för kopiering/flytt och nätverksöverföring. 0 = obegränsat."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обмежує швидкість копіювання/переміщення та передачі мережею. 0 = без обмежень."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "限制拷贝/移动和网络传输速度。0 = 不限速。"
          }
        }
      }
    },
