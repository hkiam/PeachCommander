    "Duplicate key “%@” — also on line %d. The last one silently wins.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplicitní klíč „%@“ — také na řádku %d. Poslední tiše vítězí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dubleret nøgle “%@” — også på linje %d. Den sidste vinder stiltiende."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppelter Schlüssel „%@“ — auch in Zeile %d. Der letzte gewinnt stillschweigend."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Duplicate key “%1$@” — also on line %2$d. The last one silently wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clave duplicada «%@» — también en la línea %d. La última gana en silencio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clé en double « %@ » — également à la ligne %d. La dernière l'emporte silencieusement."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Többször szereplő kulcs: „%@” — a %d. sorban is. Az utolsó némán győz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiave duplicata «%@» — anche alla riga %d. L'ultima vince silenziosamente."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중복 키 “%@” — %d번째 줄에도 있습니다. 마지막 값이 조용히 이깁니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplisert nøkkel «%@» — også på linje %d. Den siste vinner stille."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dubbele sleutel “%@” — ook op regel %d. De laatste wint stilzwijgend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zduplikowany klucz „%@” — także w wierszu %d. Ostatni po cichu wygrywa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheie duplicată „%@” — și la linia %d. Ultima câștigă în silențiu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторяющийся ключ «%@» — также в строке %d. Последний молча побеждает."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplicitný kľúč „%@“ — aj na riadku %d. Posledný tichu vyhrá."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podvojen ključ »%@« — tudi v vrstici %d. Zadnji tiho zmaga."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dubbel nyckel ”%@” — även på rad %d. Den sista vinner tyst."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторюваний ключ «%@» — також у рядку %d. Останній тихо перемагає."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重复的键“%@”— 第 %d 行也有。最后一个会静默胜出。"
          }
        }
      }
    },
