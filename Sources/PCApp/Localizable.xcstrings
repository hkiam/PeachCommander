    "Network shares and internal disks stay mounted.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Síťová sdílení a interní disky zůstanou připojené."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Netværksshares og interne diske forbliver monteret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Netzwerkfreigaben und interne Festplatten bleiben verbunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recursos de red y los discos internos siguen montados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les partages réseau et les disques internes restent montés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hálózati megosztások és a belső lemezek csatolva maradnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le condivisioni di rete e i dischi interni restano montati."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크 공유와 내장 디스크는 마운트된 상태로 유지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettverksressurser og interne disker forblir montert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Netwerkschijven en interne schijven blijven gekoppeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udziały sieciowe i dyski wewnętrzne pozostają zamontowane."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Partajările de rețea și discurile interne rămân montate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сетевые ресурсы и внутренние диски останутся подключёнными."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieťové zdieľania a interné disky zostanú pripojené."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omrežne mape v skupni rabi in notranji diski ostanejo priklopljeni."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nätverksresurser och interna diskar förblir monterade."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мережеві ресурси та внутрішні диски залишаться підключеними."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络共享和内置磁盘会保持装载状态。"
          }
