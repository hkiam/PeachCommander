    "I couldn’t produce a clear answer. Please try again or rephrase.": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se mi vytvořit jasnou odpověď. Zkuste to prosím znovu nebo přeformulujte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg kunne ikke give et klart svar. Prøv igen, eller omformuler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich konnte keine klare Antwort erzeugen. Bitte versuche es erneut oder formuliere es anders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pude dar una respuesta clara. Inténtalo de nuevo o reformula la petición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je n’ai pas pu produire de réponse claire. Veuillez réessayer ou reformuler."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem tudtam egyértelmű választ adni. Kérjük, próbálja újra, vagy fogalmazza át."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sono riuscito a produrre una risposta chiara. Riprova o riformula."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명확한 답변을 생성하지 못했습니다. 다시 시도하거나 다르게 표현해 주십시오."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg klarte ikke å gi et klart svar. Prøv igjen eller omformuler."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik kon geen duidelijk antwoord geven. Probeer het opnieuw of herformuleer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało mi się udzielić jasnej odpowiedzi. Spróbuj ponownie lub przeformułuj."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu am putut oferi un răspuns clar. Încercați din nou sau reformulați."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мне не удалось дать чёткий ответ. Пожалуйста, попробуйте снова или переформулируйте."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodarilo sa mi vytvoriť jasnú odpoveď. Skúste to znova alebo preformulujte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nisem mogel ustvariti jasnega odgovora. Poskusite znova ali preoblikujte zahtevo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jag kunde inte ge ett tydligt svar. Försök igen eller formulera om."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мені не вдалося дати чітку відповідь. Спробуйте ще раз або переформулюйте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我无法给出明确的答案。请重试或换一种表述方式。"
          }
        }
      }
    },
