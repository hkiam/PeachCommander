    "Match files that do NOT contain the search text/bytes.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhledat soubory, které NEobsahují hledaný text/bajty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Match filer, der IKKE indeholder søgeteksten/-byten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Findet Dateien, die den Suchtext/-bytes NICHT enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coincidir con los archivos que NO contengan el texto o los bytes de búsqueda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Correspondre aux fichiers qui NE contiennent PAS le texte/les octets recherchés."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Azon fájlok találata, amelyek NEM tartalmazzák a keresőszöveget/-bájtokat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova i file che NON contengono il testo/i byte di ricerca."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색 텍스트/바이트를 포함하지 않는 파일을 일치시킵니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Match filer som IKKE inneholder søketeksten/bytene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestanden zoeken die de zoektekst/-bytes NIET bevatten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopasuj pliki, które NIE zawierają szukanego tekstu/bajtów."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrivește fișierele care NU conțin textul/octeții de căutare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Находить файлы, которые НЕ содержат искомый текст/байты."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zhodovať súbory, ktoré NEOBSAHUJÚ hľadaný text/bajty."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ujemi datoteke, ki NE vsebujejo iskanega besedila/bajtov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Matcha filer som INTE innehåller söktexten/-byten."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знаходити файли, які НЕ містять текст/байти пошуку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "匹配不包含搜索文本/字节的文件。"
          }
        }
      }
    },
    "Match the search text only at word boundaries (plain-text mode)": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhledat hledaný text pouze na hranicích slov (režim prostého textu)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Match kun søgeteksten ved ordgrænser (klartekst-tilstand)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suchtext nur an Wortgrenzen abgleichen (Klartextmodus)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coincidir con el texto de búsqueda solo en los límites de palabra (modo de texto sin formato)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Correspondre au texte recherché uniquement aux limites de mots (mode texte brut)"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A keresőszöveg egyeztetése csak szóhatároknál (egyszerű szöveges mód)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova il testo di ricerca solo ai limiti di parola (modalità testo semplice)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색 텍스트를 단어 경계에서만 일치시키기(일반 텍스트 모드)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Match søketeksten kun ved ordgrenser (klartekstmodus)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De zoektekst alleen op woordgrenzen zoeken (platte-tekstmodus)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopasuj szukany tekst tylko na granicach słów (tryb zwykłego tekstu)"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrivește textul de căutare doar la limitele cuvintelor (mod text simplu)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Искать текст только по границам слов (режим обычного текста)"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zhodovať hľadaný text len na hraniciach slov (režim obyčajného textu)"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ujemi iskalno besedilo samo na mejah besed (način navadnega besedila)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Matcha söktexten endast vid ordgränser (klartextläge)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зіставляти текст пошуку лише на межах слів (режим звичайного тексту)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在单词边界处匹配搜索文本（纯文本模式）"
