    "Expected %lld line(s) but found %lld — the line count must match the number of files.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Očekáváno %lld řádků, ale nalezeno %lld — počet řádků musí odpovídat počtu souborů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forventede %lld linje(r), men fandt %lld — antallet af linjer skal svare til antallet af filer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Zeile(n) erwartet, aber %lld gefunden — die Zeilenzahl muss der Anzahl der Dateien entsprechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Expected %1$lld line(s) but found %2$lld — the line count must match the number of files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se esperaban %lld línea(s) pero se encontraron %lld — el número de líneas debe coincidir con el número de archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ligne(s) attendue(s) mais %lld trouvée(s) — le nombre de lignes doit correspondre au nombre de fichiers."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sor volt várható, de %lld található — a sorok számának egyeznie kell a fájlok számával."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attese %lld righe ma trovate %lld — il numero di righe deve corrispondere al numero di file."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개 줄이 필요하지만 %lld개를 찾았습니다 — 줄 수는 파일 수와 일치해야 합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forventet %lld linje(r), men fant %lld — antall linjer må stemme med antall filer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld regel(s) verwacht, maar %lld gevonden — het aantal regels moet overeenkomen met het aantal bestanden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oczekiwano %lld wierszy, ale znaleziono %lld — liczba wierszy musi odpowiadać liczbie plików."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se așteptau %lld linie(i), dar s-au găsit %lld — numărul de linii trebuie să corespundă numărului de fișiere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидалось %lld строк(и), но найдено %lld — число строк должно совпадать с числом файлов."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Očakávaných %lld riadkov, ale nájdených %lld — počet riadkov sa musí zhodovať s počtom súborov."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pričakovanih %lld vrstic, najdenih pa %lld — število vrstic se mora ujemati s številom datotek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förväntade %lld rad(er) men hittade %lld — antalet rader måste matcha antalet filer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очікувалося %lld рядків, але знайдено %lld — кількість рядків має збігатися з кількістю файлів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预期 %lld 行，但找到 %lld 行 — 行数必须与文件数量一致。"
          }
        }
      }
    },
