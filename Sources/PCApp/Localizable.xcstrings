    "Hi! Tell me what to do with your files. I’ll show a plan before making any changes.": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdravím! Řekněte mi, co mám udělat s vašimi soubory. Před provedením jakýchkoli změn zobrazím plán."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hej! Fortæl mig, hvad jeg skal gøre med dine filer. Jeg viser en plan, før jeg foretager ændringer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallo! Sag mir, was ich mit deinen Dateien tun soll. Bevor ich etwas ändere, zeige ich dir einen Plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Hola! Dime qué hacer con tus archivos. Te mostraré un plan antes de hacer cualquier cambio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonjour ! Dites-moi quoi faire avec vos fichiers. Je vous présenterai un plan avant d’effectuer la moindre modification."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Üdv! Mondja el, mit tegyek a fájljaival. Bármilyen módosítás előtt megmutatok egy tervet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciao! Dimmi cosa fare con i tuoi file. Mostrerò un piano prima di apportare qualsiasi modifica."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안녕하세요! 파일로 무엇을 할지 알려 주십시오. 변경하기 전에 계획을 보여 드리겠습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hei! Fortell meg hva jeg skal gjøre med filene dine. Jeg viser en plan før jeg gjør noen endringer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoi! Vertel me wat ik met je bestanden moet doen. Ik toon een plan voordat ik wijzigingen aanbreng."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cześć! Powiedz mi, co zrobić z Twoimi plikami. Pokażę plan przed wprowadzeniem jakichkolwiek zmian."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bună! Spuneți-mi ce să fac cu fișierele dvs. Voi afișa un plan înainte de a face vreo modificare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здравствуйте! Скажите, что сделать с вашими файлами. Я покажу план перед внесением любых изменений."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahoj! Povedzte mi, čo mám urobiť s vašimi súbormi. Pred vykonaním akýchkoľvek zmien zobrazím plán."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozdravljeni! Povejte mi, kaj naj naredim z vašimi datotekami. Pred kakršnimi koli spremembami vam bom prikazal načrt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hej! Berätta vad jag ska göra med dina filer. Jag visar en plan innan jag gör några ändringar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Привіт! Скажіть, що зробити з вашими файлами. Я покажу план, перш ніж вносити будь-які зміни."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你好！告诉我要对你的文件做什么。在进行任何更改之前，我会先展示一个计划。"
          }
        }
      }
    },
