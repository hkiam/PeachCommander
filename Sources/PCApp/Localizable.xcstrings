    "Only replace existing files when the source is newer": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahradit existující soubory pouze tehdy, je-li zdroj novější"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstat kun eksisterende filer, når kilden er nyere"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorhandene Dateien nur ersetzen, wenn die Quelle neuer ist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reemplazar los archivos existentes solo cuando el origen sea más reciente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne remplacer les fichiers existants que si la source est plus récente"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A meglévő fájlok cseréje csak akkor, ha a forrás újabb"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
