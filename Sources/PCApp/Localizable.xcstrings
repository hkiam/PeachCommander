  "strings": {
    "\n… and %lld more.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "\n… a dalších %lld."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "\n… og %lld mere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n… und %lld weitere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\n… y %lld más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\n… et %lld de plus."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "\n… és még %lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\n… e altri %lld."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\n… 외 %lld개 더."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "\n… og %lld til."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "\n… en nog %lld meer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\n… i %lld więcej."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "\n… și încă %lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\n… и ещё %lld."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "\n… a ešte %lld ďalších."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "\n… in še %lld."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\n… och %lld till."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\n… і ще %lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n… 还有 %lld 项。"
          }
        }
      }
    },
