    "SFTP connects directly — the proxy settings are ignored for this site.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "SFTP se připojuje přímo — nastavení proxy se pro tento server ignoruje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "SFTP forbinder direkte — proxyindstillingerne ignoreres for dette sted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SFTP verbindet direkt – die Proxy-Einstellungen werden für diese Site ignoriert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SFTP conecta directamente: los ajustes de proxy se ignoran para este sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SFTP se connecte directement — les réglages de proxy sont ignorés pour ce site."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az SFTP közvetlenül csatlakozik — a proxybeállításokat ehhez a kiszolgálóhoz figyelmen kívül hagyjuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "SFTP si connette direttamente — le impostazioni proxy vengono ignorate per questo sito."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SFTP는 직접 연결합니다. 이 사이트에는 프록시 설정이 적용되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "SFTP kobler til direkte — proxyinnstillingene ignoreres for dette stedet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "SFTP verbindt rechtstreeks — de proxy-instellingen worden voor deze site genegeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "SFTP łączy się bezpośrednio — ustawienia proxy są dla tego serwera ignorowane."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "SFTP se conectează direct — setările de proxy sunt ignorate pentru acest site."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "SFTP подключается напрямую — настройки прокси для этого сайта игнорируются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "SFTP sa pripája priamo — nastavenia proxy sa pre tento server ignorujú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "SFTP se poveže neposredno — nastavitve posrednika so za to mesto prezrte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "SFTP ansluter direkt — proxyinställningarna ignoreras för den här platsen."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "SFTP підключається напряму — налаштування проксі для цього сайта ігноруються."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SFTP 直接连接 — 此站点的代理设置会被忽略。"
          }
        }
      }
    },
