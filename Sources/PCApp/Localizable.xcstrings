    "Pick a base scheme, then customize individual shortcuts. Your changes layer on top of the scheme.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte základní schéma a poté přizpůsobte jednotlivé zkratky. Vaše změny se vrství na schéma."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg et grundskema, og tilpas derefter individuelle genveje. Dine ændringer lægges oven på skemaet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie ein Basis-Schema und passen Sie dann einzelne Kürzel an. Ihre Änderungen liegen über dem Schema."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un esquema base y luego personaliza atajos concretos. Tus cambios se superponen al esquema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un schéma de base, puis personnalisez les raccourcis individuels. Vos modifications se superposent au schéma."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válasszon alapsémát, majd szabja testre az egyes gyorsbillentyűket. A módosításai a sémára rétegződnek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli uno schema di base, quindi personalizza le singole scorciatoie. Le tue modifiche si sovrappongono allo schema."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 구성표를 선택한 다음 개별 단축키를 사용자화하십시오. 변경 사항은 구성표 위에 겹쳐집니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg et grunnoppsett, og tilpass deretter individuelle snarveier. Endringene dine legges oppå oppsettet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een basisschema en pas vervolgens afzonderlijke sneltoetsen aan. Je wijzigingen komen boven op het schema."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz schemat bazowy, a następnie dostosuj poszczególne skróty. Twoje zmiany są nakładane na schemat."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți o schemă de bază, apoi personalizați scurtături individuale. Modificările dvs. se suprapun peste schemă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите базовую схему, затем настройте отдельные сочетания клавиш. Ваши изменения накладываются поверх схемы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte základnú schému a potom prispôsobte jednotlivé skratky. Vaše zmeny sa navrstvia na schému."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite osnovno shemo, nato prilagodite posamezne bližnjice. Vaše spremembe se naložijo na vrh sheme."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj ett grundschema och anpassa sedan enskilda kortkommandon. Dina ändringar läggs ovanpå schemat."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть базову схему, а потім налаштуйте окремі комбінації клавіш. Ваші зміни накладаються поверх схеми."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选取一个基础方案，然后自定各个快捷键。你的更改将叠加在该方案之上。"
          }
        }
      }
    },
