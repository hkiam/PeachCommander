    "Search and replace only inside the selected text.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hledá a nahrazuje pouze uvnitř vybraného textu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Søger og erstatter kun inden i den markerede tekst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sucht und ersetzt nur innerhalb des markierten Texts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca y reemplaza solo dentro del texto seleccionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne recherche et ne remplace qu’à l’intérieur du texte sélectionné."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a kijelölt szövegen belül keres és cserél."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca e sostituisce solo all’interno del testo selezionato."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 텍스트 안에서만 찾고 바꿉니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Søker og erstatter bare inne i den valgte teksten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoekt en vervangt alleen binnen de geselecteerde tekst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szuka i zamienia tylko wewnątrz zaznaczonego tekstu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Caută și înlocuiește doar în textul selectat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ищет и заменяет только внутри выделенного текста."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hľadá a nahrádza iba vnútri vybraného textu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Išče in zamenjuje samo znotraj izbranega besedila."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Söker och ersätter endast inuti den markerade texten."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шукає і замінює лише всередині виділеного тексту."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在所选文本内查找和替换。"
          }
        }
      }
    },
