          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld položiek nebolo možné odstrániť (prístup zamietnutý). Odstrániť ich s právami správcu?"
          }
        },
        "sl": {
          "stringUnit": {
