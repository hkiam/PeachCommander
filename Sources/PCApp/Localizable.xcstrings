    "This permanently removes every conversation and its history.": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tímto se trvale odstraní každá konverzace a její historie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner permanent alle samtaler og deres historik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies entfernt alle Unterhaltungen und ihren Verlauf endgültig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente todas las conversaciones y su historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement toutes les conversations et leur historique."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez véglegesen eltávolít minden beszélgetést és annak előzményeit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo rimuove definitivamente ogni conversazione e la sua cronologia."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 대화와 그 기록을 영구적으로 제거합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner alle samtaler og deres historikk permanent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden alle gesprekken en hun geschiedenis definitief verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to trwałe usunięcie każdej rozmowy i jej historii."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta elimină definitiv fiecare conversație și istoricul ei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это безвозвратно удалит все разговоры и их историю."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto natrvalo odstráni každú konverzáciu a jej históriu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "S tem se trajno odstranijo vsi pogovori in njihova zgodovina."
          }
        },
