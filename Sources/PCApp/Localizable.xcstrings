    "Trailing comma. Apple's parser accepts it; Python, Go and jq do not.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čárka na konci. Parser od Applu ji přijme; Python, Go a jq nikoli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Efterstillet komma. Apples fortolker accepterer det; Python, Go og jq gør ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachgestelltes Komma. Apples Parser akzeptiert es; Python, Go und jq nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coma final. El analizador de Apple la acepta; Python, Go y jq no."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Virgule finale. L'analyseur d'Apple l'accepte ; Python, Go et jq non."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Záró vessző. Az Apple elemzője elfogadja; a Python, a Go és a jq nem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Virgola finale. Il parser di Apple la accetta; Python, Go e jq no."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뒤에 남은 쉼표입니다. Apple의 구문 분석기는 허용하지만 Python, Go, jq는 거부합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Etterfølgende komma. Apples tolker godtar det; Python, Go og jq gjør det ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Komma aan het eind. Apple's parser accepteert die; Python, Go en jq niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przecinek na końcu. Parser Apple go przyjmuje; Python, Go i jq nie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Virgulă finală. Analizatorul Apple o acceptă; Python, Go și jq nu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запятая в конце. Разборщик Apple её принимает; Python, Go и jq — нет."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čiarka na konci. Parser od Applu ju prijme; Python, Go a jq nie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vejica na koncu. Applov razčlenjevalnik jo sprejme; Python, Go in jq ne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommatecken sist. Apples tolk godtar det; Python, Go och jq gör inte det."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кома в кінці. Розбирач Apple її приймає; Python, Go і jq — ні."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "末尾多余的逗号。Apple 的解析器接受它；Python、Go 和 jq 不接受。"
          }
        }
      }
    },
