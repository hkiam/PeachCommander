    "Adding to this archive needs the “%@” tool, which is not installed.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidávání do tohoto archivu vyžaduje nástroj „%@“, který není nainstalován."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføjelse til dette arkiv kræver værktøjet “%@”, som ikke er installeret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Hinzufügen zu diesem Archiv wird das Werkzeug „%@“ benötigt, das nicht installiert ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para añadir a este archivo se necesita la herramienta «%@», que no está instalada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ajout à cette archive nécessite l’outil « %@ », qui n’est pas installé."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az archívumhoz való hozzáadáshoz a(z) „%@” eszköz szükséges, amely nincs telepítve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per aggiungere a questo archivio serve lo strumento «%@», che non è installato."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 아카이브에 추가하려면 “%@” 도구가 필요하지만 설치되어 있지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å legge til i dette arkivet krever verktøyet «%@», som ikke er installert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toevoegen aan dit archief vereist het hulpprogramma ‘%@’, dat niet is geïnstalleerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodawanie do tego archiwum wymaga narzędzia „%@”, które nie jest zainstalowane."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adăugarea în această arhivă necesită instrumentul „%@”, care nu este instalat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для добавления в этот архив нужен инструмент «%@», который не установлен."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridávanie do tohto archívu vyžaduje nástroj „%@“, ktorý nie je nainštalovaný."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajanje v ta arhiv zahteva orodje »%@«, ki ni nameščeno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att lägga till i det här arkivet kräver verktyget ”%@”, som inte är installerat."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для додавання до цього архіву потрібен інструмент «%@», який не встановлено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向此归档添加文件需要“%@”工具，但该工具未安装。"
          }
        }
      }
    },
    "Additional file extensions to open as archives (space-separated).": {
