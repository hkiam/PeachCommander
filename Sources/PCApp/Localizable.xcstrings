    "FTPS cannot go through a proxy: the tunnel cannot be upgraded to TLS. Remove the proxy or use plain FTP.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "FTPS nemůže procházet přes proxy: tunel nelze převést na TLS. Odeberte proxy nebo použijte prosté FTP."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "FTPS kan ikke gå gennem en proxy: tunnelen kan ikke opgraderes til TLS. Fjern proxyen, eller brug almindelig FTP."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FTPS kann nicht über einen Proxy laufen: Der Tunnel lässt sich nicht auf TLS umstellen. Entferne den Proxy oder verwende einfaches FTP."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FTPS no puede pasar por un proxy: el túnel no se puede convertir a TLS. Quita el proxy o usa FTP simple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le FTPS ne peut pas passer par un proxy : le tunnel ne peut pas être basculé en TLS. Supprimez le proxy ou utilisez le FTP simple."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az FTPS nem mehet proxyn keresztül: az alagút nem állítható át TLS-re. Távolítsa el a proxyt, vagy használjon sima FTP-t."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "FTPS non può passare da un proxy: il tunnel non può essere portato a TLS. Rimuovi il proxy o usa FTP semplice."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "FTPS는 프록시를 경유할 수 없습니다. 터널을 TLS로 전환할 수 없습니다. 프록시를 제거하거나 일반 FTP를 사용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "FTPS kan ikke gå gjennom en proxy: tunnelen kan ikke oppgraderes til TLS. Fjern proxyen, eller bruk vanlig FTP."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "FTPS kan niet via een proxy: de tunnel kan niet naar TLS worden omgezet. Verwijder de proxy of gebruik gewoon FTP."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "FTPS nie może iść przez proxy: tunelu nie da się przełączyć na TLS. Usuń proxy albo użyj zwykłego FTP."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "FTPS nu poate trece printr-un proxy: tunelul nu poate fi trecut pe TLS. Eliminați proxy-ul sau folosiți FTP simplu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "FTPS не может работать через прокси: туннель нельзя перевести на TLS. Уберите прокси или используйте обычный FTP."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "FTPS nemôže prechádzať cez proxy: tunel sa nedá previesť na TLS. Odstráňte proxy alebo použite obyčajné FTP."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "FTPS ne more skozi posrednika: tunela ni mogoče preklopiti na TLS. Odstranite posrednika ali uporabite navadni FTP."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "FTPS kan inte gå genom en proxy: tunneln kan inte uppgraderas till TLS. Ta bort proxyn eller använd vanlig FTP."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "FTPS не може працювати через проксі: тунель неможливо перевести на TLS. Видаліть проксі або використайте звичайний FTP."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "FTPS 无法通过代理：隧道无法升级为 TLS。请移除代理或使用普通 FTP。"
          }
        }
      }
    },
