    "Already at the outermost level.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Již na nejvyšší úrovni."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Allerede på det yderste niveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits auf der äußersten Ebene."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya está en el nivel más externo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjà au niveau le plus externe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Már a legkülső szinten van."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Già al livello più esterno."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 가장 바깥 단계입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Allerede på det ytterste nivået."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Al op het buitenste niveau."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Już na najwyższym poziomie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja la cel mai exterior nivel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже на самом внешнем уровне."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Už na najvyššej úrovni."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Že na najbolj zunanji ravni."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Redan på den yttersta nivån."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже на найзовнішнішому рівні."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经在最外层。"
          }
        }
      }
    },
    "Also list folders whose name matches, not only files": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazit i složky, jejichž název odpovídá, nejen soubory"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis også mapper, hvis navn matcher, ikke kun filer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch Ordner mit passendem Namen auflisten, nicht nur Dateien"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar también las carpetas cuyo nombre coincida, no solo los archivos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lister aussi les dossiers dont le nom correspond, pas seulement les fichiers"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a fájlok helyett az egyező nevű mappákat is felsorolja"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elenca anche le cartelle il cui nome corrisponde, non solo i file"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일뿐만 아니라 이름이 일치하는 폴더도 나열"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis også mapper med navn som stemmer, ikke bare filer"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ook mappen tonen waarvan de naam overeenkomt, niet alleen bestanden"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetlaj także foldery o pasującej nazwie, nie tylko pliki"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Listează și dosarele al căror nume corespunde, nu doar fișierele"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать также папки с подходящим именем, не только файлы"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobraziť aj priečinky, ktorých názov sa zhoduje, nielen súbory"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikaži tudi mape, katerih ime se ujema, ne le datoteke"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista även mappar vars namn matchar, inte bara filer"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати також теки, назви яких збігаються, не лише файли"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "也列出名称匹配的文件夹，而不仅是文件"
          }
        }
      }
    },
    "Also require a content-plugin field to satisfy a condition (e.g. image width > 1000).": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Navíc požadovat, aby pole z obsahového pluginu splnilo podmínku (např. šířka obrázku > 1000)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kræv desuden at et felt fra et indholds-plugin opfylder en betingelse (fx billedbredde > 1000)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusätzlich verlangen, dass ein Feld eines Inhalts-Plugins eine Bedingung erfüllt (z. B. Bildbreite > 1000)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exigir además que un campo de un plugin de contenido cumpla una condición (p. ej. anchura de imagen > 1000)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exiger en plus qu’un champ de plug-in de contenu satisfasse une condition (p. ex. largeur d’image > 1000)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezenkívül megköveteli, hogy egy tartalombővítmény mezője megfeleljen egy feltételnek (pl. képszélesség > 1000)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiedere inoltre che un campo di un plug-in di contenuto soddisfi una condizione (ad es. larghezza immagine > 1000)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가로 콘텐츠 플러그인 필드가 조건을 만족하도록 요구합니다(예: 이미지 너비 > 1000)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Krev i tillegg at et felt fra et innholds-plugin oppfyller en betingelse (f.eks. bildebredde > 1000)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bovendien eisen dat een veld van een inhoudsplug-in aan een voorwaarde voldoet (bijv. afbeeldingsbreedte > 1000)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodatkowo wymagaj, aby pole z wtyczki zawartości spełniało warunek (np. szerokość obrazu > 1000)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cere în plus ca un câmp dintr-un plugin de conținut să îndeplinească o condiție (de ex. lățimea imaginii > 1000)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дополнительно требовать, чтобы поле контентного плагина удовлетворяло условию (например, ширина изображения > 1000)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Navyše požadovať, aby pole z obsahového pluginu splnilo podmienku (napr. šírka obrázka > 1000)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poleg tega zahtevaj, da polje iz vsebinskega vtičnika izpolni pogoj (npr. širina slike > 1000)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kräv dessutom att ett fält från ett innehållstillägg uppfyller ett villkor (t.ex. bildbredd > 1000)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додатково вимагати, щоб поле контентного плагіна відповідало умові (наприклад, ширина зображення > 1000)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还要求内容插件的某个字段满足条件（例如图像宽度 > 1000）。"
          }
        }
      }
    },
