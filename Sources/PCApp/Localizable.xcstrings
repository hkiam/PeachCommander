          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstatt kun eksisterende filer når kilden er nyere"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestaande bestanden alleen vervangen als de bron nieuwer is"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastępuj istniejące pliki tylko, gdy źródło jest nowsze"
