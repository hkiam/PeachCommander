    "%@ cannot be written with your current rights. macOS will ask for authorization; the file keeps its owner and permissions.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nelze zapsat s vašimi současnými právy. macOS požádá o autorizaci; soubor si ponechá vlastníka i práva."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan ikke skrives med dine nuværende rettigheder. macOS beder om godkendelse; filen beholder sin ejer og sine rettigheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lässt sich mit Ihren derzeitigen Rechten nicht schreiben. macOS fragt nach einer Autorisierung; Eigentümer und Rechte der Datei bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no se puede escribir con sus permisos actuales. macOS pedirá autorización; el archivo conserva su propietario y sus permisos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne peut pas être écrit avec vos droits actuels. macOS demandera une autorisation ; le fichier conserve son propriétaire et ses permissions."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ a jelenlegi jogaival nem írható. A macOS engedélyt fog kérni; a fájl megtartja a tulajdonosát és a jogosultságait."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non può essere scritto con i vostri diritti attuali. macOS chiederà un’autorizzazione; il file mantiene proprietario e permessi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 권한으로는 %@을 쓸 수 없습니다. macOS가 인증을 요청하며, 파일의 소유자와 권한은 그대로 유지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan ikke skrives med rettighetene dine. macOS ber om godkjenning; fila beholder eier og rettigheter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan met je huidige rechten niet worden geschreven. macOS vraagt om autorisatie; het bestand houdt zijn eigenaar en rechten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zapisać %@ z bieżącymi uprawnieniami. macOS poprosi o autoryzację; plik zachowa właściciela i uprawnienia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nu poate fi scris cu drepturile actuale. macOS va cere o autorizare; fișierul își păstrează proprietarul și permisiunile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ нельзя записать с вашими текущими правами. macOS запросит авторизацию; владелец и права файла сохранятся."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie je možné zapísať s vašimi súčasnými právami. macOS požiada o autorizáciu; súbor si ponechá vlastníka aj práva."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ z vašimi trenutnimi pravicami ni mogoče zapisati. macOS bo zahteval odobritev; datoteka ohrani lastnika in pravice."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan inte skrivas med dina nuvarande rättigheter. macOS frågar efter behörighet; filen behåller sin ägare och sina rättigheter."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не можна записати з вашими поточними правами. macOS запитає авторизацію; власник і права файла збережуться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以当前权限无法写入 %@。macOS 会请求授权；文件的所有者和权限保持不变。"
          }
        }
      }
    },
    "%@ cannot represent this value": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nedokáže tuto hodnotu vyjádřit"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan ikke repræsentere denne værdi"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann diesen Wert nicht darstellen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no puede representar este valor"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne peut pas représenter cette valeur"
          }
        },
        "hu": {
