    "One or more folders, separated by “;”, are each searched (F-150).": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prohledá se každá zadaná složka, oddělená znakem „;“ (F-150)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver angivet mappe, adskilt med “;”, gennemsøges (F-150)."
          }
        },
        "de": {
